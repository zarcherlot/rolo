{
  "$defs": {
    "DiscoveryStatus": {
      "enum": [
        "SUCCEEDED",
        "PARTIAL",
        "UNAVAILABLE",
        "FAILED"
      ],
      "title": "DiscoveryStatus",
      "type": "string"
    },
    "ProbeResult": {
      "properties": {
        "layer": {
          "title": "Layer",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/DiscoveryStatus"
        },
        "data": {
          "additionalProperties": true,
          "title": "Data",
          "type": "object"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "errors": {
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        }
      },
      "required": [
        "layer",
        "status"
      ],
      "title": "ProbeResult",
      "type": "object"
    },
    "ToolDescriptor": {
      "properties": {
        "schema_version": {
          "default": "robot-tool/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "operation": {
          "title": "Operation",
          "type": "string"
        },
        "canonical_cli": {
          "items": {
            "type": "string"
          },
          "title": "Canonical Cli",
          "type": "array"
        },
        "layer": {
          "title": "Layer",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "risk": {
          "default": "R0",
          "title": "Risk",
          "type": "string"
        },
        "access": {
          "default": "read",
          "title": "Access",
          "type": "string"
        },
        "idempotent": {
          "default": true,
          "title": "Idempotent",
          "type": "boolean"
        },
        "cancelable": {
          "default": false,
          "title": "Cancelable",
          "type": "boolean"
        },
        "availability": {
          "title": "Availability",
          "type": "string"
        },
        "adapter": {
          "title": "Adapter",
          "type": "string"
        },
        "input_schema": {
          "additionalProperties": true,
          "title": "Input Schema",
          "type": "object"
        },
        "output_schema": {
          "additionalProperties": true,
          "title": "Output Schema",
          "type": "object"
        },
        "capability_requirements": {
          "items": {
            "type": "string"
          },
          "title": "Capability Requirements",
          "type": "array"
        },
        "preconditions": {
          "items": {
            "type": "string"
          },
          "title": "Preconditions",
          "type": "array"
        },
        "postconditions": {
          "items": {
            "type": "string"
          },
          "title": "Postconditions",
          "type": "array"
        },
        "semantic_bindings": {
          "items": {
            "type": "string"
          },
          "title": "Semantic Bindings",
          "type": "array"
        },
        "side_effects": {
          "items": {
            "type": "string"
          },
          "title": "Side Effects",
          "type": "array"
        },
        "resource_locks": {
          "items": {
            "type": "string"
          },
          "title": "Resource Locks",
          "type": "array"
        },
        "max_duration_s": {
          "default": 30.0,
          "title": "Max Duration S",
          "type": "number"
        },
        "rate_limit": {
          "default": "on_demand",
          "title": "Rate Limit",
          "type": "string"
        },
        "error_codes": {
          "items": {
            "type": "string"
          },
          "title": "Error Codes",
          "type": "array"
        },
        "retry_policy": {
          "default": "bounded_exponential_backoff_for_read_only_probe",
          "title": "Retry Policy",
          "type": "string"
        },
        "compensation_operation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Compensation Operation"
        },
        "observation_overhead": {
          "default": "bounded read-only probe",
          "title": "Observation Overhead",
          "type": "string"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "operation",
        "canonical_cli",
        "layer",
        "description",
        "availability",
        "adapter"
      ],
      "title": "ToolDescriptor",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "robot-discovery/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "discovery_id": {
      "title": "Discovery Id",
      "type": "string"
    },
    "robot_id": {
      "title": "Robot Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/DiscoveryStatus"
    },
    "platform": {
      "additionalProperties": true,
      "title": "Platform",
      "type": "object"
    },
    "capability_manifest": {
      "additionalProperties": true,
      "title": "Capability Manifest",
      "type": "object"
    },
    "probes": {
      "additionalProperties": {
        "$ref": "#/$defs/ProbeResult"
      },
      "title": "Probes",
      "type": "object"
    },
    "semantic_bindings": {
      "additionalProperties": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Semantic Bindings",
      "type": "object"
    },
    "tool_catalog": {
      "items": {
        "$ref": "#/$defs/ToolDescriptor"
      },
      "title": "Tool Catalog",
      "type": "array"
    },
    "software_summary": {
      "additionalProperties": true,
      "title": "Software Summary",
      "type": "object"
    },
    "software_summary_ref": {
      "default": "",
      "title": "Software Summary Ref",
      "type": "string"
    },
    "dependency_report_ref": {
      "default": "",
      "title": "Dependency Report Ref",
      "type": "string"
    },
    "active_discovery_report_ref": {
      "default": "",
      "title": "Active Discovery Report Ref",
      "type": "string"
    },
    "discovery_mode": {
      "default": "",
      "title": "Discovery Mode",
      "type": "string"
    },
    "source_roots": {
      "items": {
        "type": "string"
      },
      "title": "Source Roots",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "discovery_id",
    "robot_id",
    "status",
    "platform",
    "capability_manifest",
    "probes"
  ],
  "title": "DiscoveryReport",
  "type": "object"
}