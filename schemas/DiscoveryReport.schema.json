{
  "$defs": {
    "DiscoveryStatus": {
      "enum": [
        "SUCCEEDED",
        "PARTIAL",
        "UNAVAILABLE",
        "FAILED"
      ],
      "title": "DiscoveryStatus",
      "type": "string"
    },
    "OperationCandidate": {
      "additionalProperties": false,
      "description": "Untrusted applicability and binding evidence from discovery.",
      "properties": {
        "operation": {
          "title": "Operation",
          "type": "string"
        },
        "semantic_bindings": {
          "items": {
            "type": "string"
          },
          "title": "Semantic Bindings",
          "type": "array"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "route_evidence": {
          "items": {
            "$ref": "#/$defs/RouteEvidence"
          },
          "title": "Route Evidence",
          "type": "array"
        },
        "executable_ids": {
          "items": {
            "type": "string"
          },
          "title": "Executable Ids",
          "type": "array"
        },
        "hardware_resource_ids": {
          "items": {
            "type": "string"
          },
          "title": "Hardware Resource Ids",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "status": {
          "const": "DISCOVERED_UNVERIFIED",
          "default": "DISCOVERED_UNVERIFIED",
          "title": "Status",
          "type": "string"
        },
        "origin": {
          "default": "DETERMINISTIC",
          "enum": [
            "DETERMINISTIC",
            "HEURISTIC_AGENT"
          ],
          "title": "Origin",
          "type": "string"
        },
        "semantic_review_required": {
          "default": false,
          "title": "Semantic Review Required",
          "type": "boolean"
        },
        "semantic_review_disposition": {
          "default": "NOT_REVIEWED",
          "enum": [
            "NOT_REVIEWED",
            "ACCEPT",
            "DEFER",
            "REJECT"
          ],
          "title": "Semantic Review Disposition",
          "type": "string"
        },
        "route_review_dispositions": {
          "additionalProperties": {
            "enum": [
              "ACCEPT",
              "DEFER",
              "REJECT"
            ],
            "type": "string"
          },
          "title": "Route Review Dispositions",
          "type": "object"
        },
        "semantic_review_artifact_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Semantic Review Artifact Sha256"
        }
      },
      "required": [
        "operation"
      ],
      "title": "OperationCandidate",
      "type": "object"
    },
    "ProbeResult": {
      "properties": {
        "layer": {
          "title": "Layer",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/DiscoveryStatus"
        },
        "data": {
          "additionalProperties": true,
          "title": "Data",
          "type": "object"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "errors": {
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        }
      },
      "required": [
        "layer",
        "status"
      ],
      "title": "ProbeResult",
      "type": "object"
    },
    "RouteEvidence": {
      "additionalProperties": false,
      "description": "One stable, typed operation route observed or declared during discovery.",
      "properties": {
        "schema_version": {
          "const": "robot-route-evidence/v2",
          "default": "robot-route-evidence/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "resource_id": {
          "minLength": 1,
          "title": "Resource Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "ros_topic",
            "ros_service",
            "ros_action",
            "device",
            "cli"
          ],
          "title": "Kind",
          "type": "string"
        },
        "endpoint": {
          "minLength": 1,
          "title": "Endpoint",
          "type": "string"
        },
        "interface_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interface Type"
        },
        "interface_schema_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interface Schema Sha256"
        },
        "provider_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Id"
        },
        "runtime_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime Revision"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        },
        "evidence_origin": {
          "enum": [
            "OBSERVED_RUNTIME",
            "DECLARED_STATIC"
          ],
          "title": "Evidence Origin",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "resource_id",
        "kind",
        "endpoint",
        "evidence_origin",
        "source"
      ],
      "title": "RouteEvidence",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "robot-discovery/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "discovery_id": {
      "title": "Discovery Id",
      "type": "string"
    },
    "robot_id": {
      "title": "Robot Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/DiscoveryStatus"
    },
    "platform": {
      "additionalProperties": true,
      "title": "Platform",
      "type": "object"
    },
    "capability_manifest": {
      "additionalProperties": true,
      "title": "Capability Manifest",
      "type": "object"
    },
    "probes": {
      "additionalProperties": {
        "$ref": "#/$defs/ProbeResult"
      },
      "title": "Probes",
      "type": "object"
    },
    "semantic_bindings": {
      "additionalProperties": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Semantic Bindings",
      "type": "object"
    },
    "operation_candidates": {
      "items": {
        "$ref": "#/$defs/OperationCandidate"
      },
      "title": "Operation Candidates",
      "type": "array"
    },
    "software_summary": {
      "additionalProperties": true,
      "title": "Software Summary",
      "type": "object"
    },
    "software_summary_ref": {
      "default": "",
      "title": "Software Summary Ref",
      "type": "string"
    },
    "dependency_report_ref": {
      "default": "",
      "title": "Dependency Report Ref",
      "type": "string"
    },
    "active_discovery_report_ref": {
      "default": "",
      "title": "Active Discovery Report Ref",
      "type": "string"
    },
    "review_ref": {
      "default": "",
      "title": "Review Ref",
      "type": "string"
    },
    "discovery_mode": {
      "default": "",
      "title": "Discovery Mode",
      "type": "string"
    },
    "heuristic_analysis_ref": {
      "default": "",
      "title": "Heuristic Analysis Ref",
      "type": "string"
    },
    "heuristic_status": {
      "default": "DISABLED",
      "title": "Heuristic Status",
      "type": "string"
    },
    "heuristic_mode": {
      "default": "disabled",
      "title": "Heuristic Mode",
      "type": "string"
    },
    "heuristic_inferred_operation_count": {
      "default": 0,
      "minimum": 0,
      "title": "Heuristic Inferred Operation Count",
      "type": "integer"
    },
    "heuristic_missing_evidence_count": {
      "default": 0,
      "minimum": 0,
      "title": "Heuristic Missing Evidence Count",
      "type": "integer"
    },
    "source_roots": {
      "items": {
        "type": "string"
      },
      "title": "Source Roots",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "discovery_id",
    "robot_id",
    "status",
    "platform",
    "capability_manifest",
    "probes"
  ],
  "title": "DiscoveryReport",
  "type": "object"
}