{
  "$defs": {
    "DiscoveryStatus": {
      "enum": [
        "SUCCEEDED",
        "PARTIAL",
        "UNAVAILABLE",
        "FAILED"
      ],
      "title": "DiscoveryStatus",
      "type": "string"
    },
    "OperationCandidate": {
      "additionalProperties": false,
      "description": "Untrusted applicability and binding evidence from discovery.",
      "properties": {
        "operation": {
          "title": "Operation",
          "type": "string"
        },
        "semantic_bindings": {
          "items": {
            "type": "string"
          },
          "title": "Semantic Bindings",
          "type": "array"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        },
        "route_evidence": {
          "items": {
            "$ref": "#/$defs/RouteEvidence"
          },
          "title": "Route Evidence",
          "type": "array"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        },
        "status": {
          "const": "DISCOVERED_UNVERIFIED",
          "default": "DISCOVERED_UNVERIFIED",
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "operation"
      ],
      "title": "OperationCandidate",
      "type": "object"
    },
    "ProbeResult": {
      "properties": {
        "layer": {
          "title": "Layer",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/DiscoveryStatus"
        },
        "data": {
          "additionalProperties": true,
          "title": "Data",
          "type": "object"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "errors": {
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        }
      },
      "required": [
        "layer",
        "status"
      ],
      "title": "ProbeResult",
      "type": "object"
    },
    "RouteEvidence": {
      "additionalProperties": false,
      "description": "One normalized operation endpoint observed or declared during discovery.",
      "properties": {
        "kind": {
          "enum": [
            "ros_topic",
            "ros_service",
            "ros_action",
            "device",
            "cli"
          ],
          "title": "Kind",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "observed": {
          "default": false,
          "title": "Observed",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "name",
        "source"
      ],
      "title": "RouteEvidence",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "robot-discovery/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "discovery_id": {
      "title": "Discovery Id",
      "type": "string"
    },
    "robot_id": {
      "title": "Robot Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/DiscoveryStatus"
    },
    "platform": {
      "additionalProperties": true,
      "title": "Platform",
      "type": "object"
    },
    "capability_manifest": {
      "additionalProperties": true,
      "title": "Capability Manifest",
      "type": "object"
    },
    "probes": {
      "additionalProperties": {
        "$ref": "#/$defs/ProbeResult"
      },
      "title": "Probes",
      "type": "object"
    },
    "semantic_bindings": {
      "additionalProperties": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Semantic Bindings",
      "type": "object"
    },
    "operation_candidates": {
      "items": {
        "$ref": "#/$defs/OperationCandidate"
      },
      "title": "Operation Candidates",
      "type": "array"
    },
    "software_summary": {
      "additionalProperties": true,
      "title": "Software Summary",
      "type": "object"
    },
    "software_summary_ref": {
      "default": "",
      "title": "Software Summary Ref",
      "type": "string"
    },
    "dependency_report_ref": {
      "default": "",
      "title": "Dependency Report Ref",
      "type": "string"
    },
    "active_discovery_report_ref": {
      "default": "",
      "title": "Active Discovery Report Ref",
      "type": "string"
    },
    "review_ref": {
      "default": "",
      "title": "Review Ref",
      "type": "string"
    },
    "discovery_mode": {
      "default": "",
      "title": "Discovery Mode",
      "type": "string"
    },
    "source_roots": {
      "items": {
        "type": "string"
      },
      "title": "Source Roots",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "discovery_id",
    "robot_id",
    "status",
    "platform",
    "capability_manifest",
    "probes"
  ],
  "title": "DiscoveryReport",
  "type": "object"
}