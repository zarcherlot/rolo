{
  "$defs": {
    "AdapterSandboxBudget": {
      "additionalProperties": false,
      "description": "The same address-space/process controls consumed by BoundedAdapterRunner.",
      "properties": {
        "max_address_space_bytes": {
          "default": 4294967296,
          "maximum": 68719476736,
          "minimum": 536870912,
          "title": "Max Address Space Bytes",
          "type": "integer"
        },
        "max_processes": {
          "default": 128,
          "maximum": 512,
          "minimum": 16,
          "title": "Max Processes",
          "type": "integer"
        }
      },
      "title": "AdapterSandboxBudget",
      "type": "object"
    },
    "TargetObservedRuntimeEnvironment": {
      "additionalProperties": false,
      "description": "Secret-closed environment whose paths are validated only on the target.",
      "properties": {
        "CYCLONEDDS_URI": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cyclonedds Uri"
        },
        "ROS_AUTOMATIC_DISCOVERY_RANGE": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ros Automatic Discovery Range"
        },
        "ROS_DISCOVERY_SERVER": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ros Discovery Server"
        },
        "ROS_DISTRO": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ros Distro"
        },
        "ROS_DOMAIN_ID": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ros Domain Id"
        },
        "ROS_LOCALHOST_ONLY": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ros Localhost Only"
        },
        "ROS_STATIC_PEERS": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ros Static Peers"
        },
        "ROS_VERSION": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ros Version"
        },
        "RMW_IMPLEMENTATION": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rmw Implementation"
        },
        "FASTRTPS_DEFAULT_PROFILES_FILE": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fastrtps Default Profiles File"
        },
        "AMENT_PREFIX_PATH": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ament Prefix Path"
        },
        "CMAKE_PREFIX_PATH": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cmake Prefix Path"
        },
        "COLCON_PREFIX_PATH": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Colcon Prefix Path"
        },
        "DYLD_LIBRARY_PATH": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dyld Library Path"
        },
        "LD_LIBRARY_PATH": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ld Library Path"
        },
        "PYTHONPATH": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pythonpath"
        },
        "PATH": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        }
      },
      "title": "TargetObservedRuntimeEnvironment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "rolo-located-runtime-context/v1",
      "default": "rolo-located-runtime-context/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "target_os": {
      "const": "linux",
      "default": "linux",
      "title": "Target Os",
      "type": "string"
    },
    "target_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Target Id",
      "type": "string"
    },
    "robot_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Robot Id",
      "type": "string"
    },
    "workspace_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Workspace Id",
      "type": "string"
    },
    "workspace_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Workspace Sha256",
      "type": "string"
    },
    "adapter_entrypoint": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Adapter Entrypoint",
      "type": "string"
    },
    "python_interpreter": {
      "anyOf": [
        {
          "maxLength": 4096,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Python Interpreter"
    },
    "virtualenv_root": {
      "anyOf": [
        {
          "maxLength": 4096,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Virtualenv Root"
    },
    "editable_roots": {
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "title": "Editable Roots",
      "type": "array"
    },
    "runtime_environment": {
      "$ref": "#/$defs/TargetObservedRuntimeEnvironment"
    },
    "sandbox_budget": {
      "$ref": "#/$defs/AdapterSandboxBudget"
    }
  },
  "required": [
    "target_id",
    "robot_id",
    "workspace_id",
    "workspace_sha256",
    "adapter_entrypoint"
  ],
  "title": "LocatedRuntimeContext",
  "type": "object"
}