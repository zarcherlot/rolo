{
  "$defs": {
    "CredentialPurpose": {
      "enum": [
        "SSH_PROVISIONING",
        "SSH_BOOTSTRAP",
        "SSH_RUNTIME",
        "SSH_CA",
        "LEGACY_COLLECTOR_VERIFICATION"
      ],
      "title": "CredentialPurpose",
      "type": "string"
    },
    "TargetArchitecture": {
      "enum": [
        "x86_64",
        "aarch64"
      ],
      "title": "TargetArchitecture",
      "type": "string"
    },
    "W10AcceptanceGateId": {
      "enum": [
        "PROVISIONING_TYPED_INSPECTION",
        "BOOTSTRAP_CAPABILITY_INSPECTION",
        "RUNTIME_TYPED_INSPECTION",
        "RUNTIME_INSTALLATION_BINDING",
        "REAL_SSH_TEST_REPORT",
        "PLATFORM_BINDING"
      ],
      "title": "W10AcceptanceGateId",
      "type": "string"
    },
    "W10AutomatedResult": {
      "enum": [
        "PASSED",
        "FAILED"
      ],
      "title": "W10AutomatedResult",
      "type": "string"
    },
    "W10InspectionEvidence": {
      "additionalProperties": false,
      "properties": {
        "gate_id": {
          "$ref": "#/$defs/W10AcceptanceGateId"
        },
        "credential_purpose": {
          "anyOf": [
            {
              "$ref": "#/$defs/CredentialPurpose"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "automated_result": {
          "$ref": "#/$defs/W10AutomatedResult"
        },
        "request_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Sha256"
        },
        "result_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Result Sha256"
        },
        "error_code": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "finished_at": {
          "format": "date-time",
          "title": "Finished At",
          "type": "string"
        }
      },
      "required": [
        "gate_id",
        "automated_result",
        "started_at",
        "finished_at"
      ],
      "title": "W10InspectionEvidence",
      "type": "object"
    },
    "W10ObservedPlatform": {
      "additionalProperties": false,
      "properties": {
        "machine": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Machine",
          "type": "string"
        },
        "os": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Os",
          "type": "string"
        },
        "os_release": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Os Release",
          "type": "string"
        },
        "python": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Python",
          "type": "string"
        },
        "python_executable": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Python Executable",
          "type": "string"
        },
        "uid": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uid"
        }
      },
      "required": [
        "machine",
        "os",
        "os_release",
        "python",
        "python_executable"
      ],
      "title": "W10ObservedPlatform",
      "type": "object"
    },
    "W10ObservedRuntimeInstallation": {
      "additionalProperties": false,
      "description": "Path-free projection of the target-validated active runtime index.",
      "properties": {
        "schema_version": {
          "const": "rolo-w10-observed-runtime-installation/v1",
          "default": "rolo-w10-observed-runtime-installation/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "current_package_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Current Package Id",
          "type": "string"
        },
        "current_package_version": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$",
          "title": "Current Package Version",
          "type": "string"
        },
        "current_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Current Manifest Sha256",
          "type": "string"
        },
        "previous_package_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Package Id"
        },
        "previous_package_version": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Package Version"
        },
        "previous_manifest_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Manifest Sha256"
        }
      },
      "required": [
        "current_package_id",
        "current_package_version",
        "current_manifest_sha256"
      ],
      "title": "W10ObservedRuntimeInstallation",
      "type": "object"
    },
    "W10RealSshAcceptanceRequest": {
      "additionalProperties": false,
      "description": "Operator-supplied immutable bindings for one real-target acceptance run.",
      "properties": {
        "schema_version": {
          "const": "rolo-w10-real-ssh-acceptance-request/v1",
          "default": "rolo-w10-real-ssh-acceptance-request/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "target_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Target Id",
          "type": "string"
        },
        "environment_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Environment Id",
          "type": "string"
        },
        "expected_architecture": {
          "$ref": "#/$defs/TargetArchitecture"
        },
        "os_image_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Os Image Sha256",
          "type": "string"
        },
        "package_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Package Id",
          "type": "string"
        },
        "package_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Package Manifest Sha256",
          "type": "string"
        },
        "acceptance_suite_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Acceptance Suite Sha256",
          "type": "string"
        },
        "test_report_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Test Report Sha256",
          "type": "string"
        },
        "timeout_s": {
          "default": 20.0,
          "maximum": 300.0,
          "minimum": 1.0,
          "title": "Timeout S",
          "type": "number"
        }
      },
      "required": [
        "target_id",
        "environment_id",
        "expected_architecture",
        "os_image_sha256",
        "package_id",
        "package_manifest_sha256",
        "acceptance_suite_sha256",
        "test_report_sha256"
      ],
      "title": "W10RealSshAcceptanceRequest",
      "type": "object"
    },
    "W10TestReportSummary": {
      "additionalProperties": false,
      "description": "Bounded aggregate extracted from a real pytest JUnit XML report.",
      "properties": {
        "schema_version": {
          "const": "rolo-w10-test-report-summary/v1",
          "default": "rolo-w10-test-report-summary/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "format": {
          "const": "JUNIT_XML",
          "default": "JUNIT_XML",
          "title": "Format",
          "type": "string"
        },
        "report_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Report Sha256",
          "type": "string"
        },
        "test_count": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Test Count",
          "type": "integer"
        },
        "failure_count": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Failure Count",
          "type": "integer"
        },
        "error_count": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Error Count",
          "type": "integer"
        },
        "skipped_count": {
          "maximum": 1000000,
          "minimum": 0,
          "title": "Skipped Count",
          "type": "integer"
        },
        "duration_s": {
          "maximum": 31536000.0,
          "minimum": 0.0,
          "title": "Duration S",
          "type": "number"
        },
        "minimum_executed_tests": {
          "const": 4,
          "default": 4,
          "title": "Minimum Executed Tests",
          "type": "integer"
        },
        "automated_result": {
          "$ref": "#/$defs/W10AutomatedResult"
        }
      },
      "required": [
        "report_sha256",
        "test_count",
        "failure_count",
        "error_count",
        "skipped_count",
        "duration_s",
        "automated_result"
      ],
      "title": "W10TestReportSummary",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Secret-closed automated evidence; deliberately not a production acceptance.",
  "properties": {
    "schema_version": {
      "const": "rolo-w10-real-ssh-acceptance-receipt/v1",
      "default": "rolo-w10-real-ssh-acceptance-receipt/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "request": {
      "$ref": "#/$defs/W10RealSshAcceptanceRequest"
    },
    "request_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Sha256",
      "type": "string"
    },
    "target_profile_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Target Profile Sha256",
      "type": "string"
    },
    "connection_profile_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Connection Profile Sha256",
      "type": "string"
    },
    "endpoint_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Endpoint Sha256",
      "type": "string"
    },
    "known_hosts_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Known Hosts Sha256",
      "type": "string"
    },
    "pinned_host_key_sha256": {
      "pattern": "^SHA256:[A-Za-z0-9+/]{43}$",
      "title": "Pinned Host Key Sha256",
      "type": "string"
    },
    "identity_binding_sha256": {
      "additionalProperties": {
        "type": "string"
      },
      "propertyNames": {
        "$ref": "#/$defs/CredentialPurpose"
      },
      "title": "Identity Binding Sha256",
      "type": "object"
    },
    "provisioning_platform": {
      "anyOf": [
        {
          "$ref": "#/$defs/W10ObservedPlatform"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "runtime_platform": {
      "anyOf": [
        {
          "$ref": "#/$defs/W10ObservedPlatform"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "runtime_installation": {
      "anyOf": [
        {
          "$ref": "#/$defs/W10ObservedRuntimeInstallation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "bootstrap_capabilities_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bootstrap Capabilities Sha256"
    },
    "test_report": {
      "$ref": "#/$defs/W10TestReportSummary"
    },
    "gates": {
      "items": {
        "$ref": "#/$defs/W10InspectionEvidence"
      },
      "maxItems": 6,
      "minItems": 6,
      "title": "Gates",
      "type": "array"
    },
    "automated_result": {
      "$ref": "#/$defs/W10AutomatedResult"
    },
    "matrix_status": {
      "const": "NOT_VERIFIED",
      "default": "NOT_VERIFIED",
      "title": "Matrix Status",
      "type": "string"
    },
    "manual_review_required": {
      "const": true,
      "default": true,
      "title": "Manual Review Required",
      "type": "boolean"
    },
    "production_ready": {
      "const": false,
      "default": false,
      "title": "Production Ready",
      "type": "boolean"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    }
  },
  "required": [
    "request",
    "request_sha256",
    "target_profile_sha256",
    "connection_profile_sha256",
    "endpoint_sha256",
    "known_hosts_sha256",
    "pinned_host_key_sha256",
    "identity_binding_sha256",
    "test_report",
    "gates",
    "automated_result",
    "started_at",
    "finished_at"
  ],
  "title": "W10RealSshAcceptanceReceipt",
  "type": "object"
}