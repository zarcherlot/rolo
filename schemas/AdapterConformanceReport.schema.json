{
  "$defs": {
    "ConformanceScope": {
      "enum": [
        "LOCAL_STATIC"
      ],
      "title": "ConformanceScope",
      "type": "string"
    },
    "OperationConformance": {
      "additionalProperties": false,
      "description": "Adapter Agent local-static declarations; never physical or runtime proof.",
      "properties": {
        "operation": {
          "title": "Operation",
          "type": "string"
        },
        "schema_valid": {
          "title": "Schema Valid",
          "type": "boolean"
        },
        "errors_valid": {
          "title": "Errors Valid",
          "type": "boolean"
        },
        "idempotency_valid": {
          "title": "Idempotency Valid",
          "type": "boolean"
        },
        "cancellation_valid": {
          "title": "Cancellation Valid",
          "type": "boolean"
        },
        "validation_scopes": {
          "items": {
            "$ref": "#/$defs/ConformanceScope"
          },
          "title": "Validation Scopes",
          "type": "array"
        },
        "evidence": {
          "items": {
            "type": "string"
          },
          "title": "Evidence",
          "type": "array"
        }
      },
      "required": [
        "operation",
        "schema_valid",
        "errors_valid",
        "idempotency_valid",
        "cancellation_valid"
      ],
      "title": "OperationConformance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Advisory Agent report retained as audit input to the independent Rolo gate.",
  "properties": {
    "schema_version": {
      "default": "robot-adapter-conformance/v3",
      "enum": [
        "robot-adapter-conformance/v1",
        "robot-adapter-conformance/v2",
        "robot-adapter-conformance/v3"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "owner": {
      "const": "ADAPTER_AGENT",
      "default": "ADAPTER_AGENT",
      "title": "Owner",
      "type": "string"
    },
    "coverage": {
      "const": "BUNDLE_CANDIDATES_ONLY",
      "default": "BUNDLE_CANDIDATES_ONLY",
      "title": "Coverage",
      "type": "string"
    },
    "robot_id": {
      "title": "Robot Id",
      "type": "string"
    },
    "discovery_id": {
      "title": "Discovery Id",
      "type": "string"
    },
    "operations": {
      "items": {
        "$ref": "#/$defs/OperationConformance"
      },
      "title": "Operations",
      "type": "array"
    }
  },
  "required": [
    "robot_id",
    "discovery_id",
    "operations"
  ],
  "title": "AdapterConformanceReport",
  "type": "object"
}