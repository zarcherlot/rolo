{
  "$defs": {
    "AdapterReleaseActivationOperation": {
      "enum": [
        "ACTIVATE",
        "ROLLBACK"
      ],
      "title": "AdapterReleaseActivationOperation",
      "type": "string"
    },
    "AdapterReleaseGateReceipt": {
      "additionalProperties": false,
      "description": "Controller Gate proof that one target-side `describe` matched a frozen release.",
      "properties": {
        "schema_version": {
          "const": "rolo-adapter-release-gate-receipt/v1",
          "default": "rolo-adapter-release-gate-receipt/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "gate_status": {
          "const": "PASSED",
          "default": "PASSED",
          "title": "Gate Status",
          "type": "string"
        },
        "target_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Target Id",
          "type": "string"
        },
        "robot_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Robot Id",
          "type": "string"
        },
        "collector_id": {
          "pattern": "^collector-[0-9a-f]{32}$",
          "title": "Collector Id",
          "type": "string"
        },
        "descriptor_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Descriptor Sha256",
          "type": "string"
        },
        "release_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Release Id",
          "type": "string"
        },
        "transfer_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Transfer Manifest Sha256",
          "type": "string"
        },
        "release_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Release Manifest Sha256",
          "type": "string"
        },
        "bundle_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Bundle Manifest Sha256",
          "type": "string"
        },
        "runtime_context_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Runtime Context Sha256",
          "type": "string"
        },
        "sandbox_profile_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sandbox Profile Sha256",
          "type": "string"
        },
        "describe_request_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Describe Request Sha256",
          "type": "string"
        },
        "describe_attestation_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Describe Attestation Sha256",
          "type": "string"
        },
        "describe_payload_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Describe Payload Sha256",
          "type": "string"
        },
        "describe_output_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Describe Output Sha256",
          "type": "string"
        },
        "gate_report_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Gate Report Sha256",
          "type": "string"
        },
        "verified_at": {
          "format": "date-time",
          "title": "Verified At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        }
      },
      "required": [
        "target_id",
        "robot_id",
        "collector_id",
        "descriptor_sha256",
        "release_id",
        "transfer_manifest_sha256",
        "release_manifest_sha256",
        "bundle_manifest_sha256",
        "runtime_context_sha256",
        "sandbox_profile_sha256",
        "describe_request_sha256",
        "describe_attestation_sha256",
        "describe_payload_sha256",
        "describe_output_sha256",
        "gate_report_sha256",
        "verified_at",
        "expires_at"
      ],
      "title": "AdapterReleaseGateReceipt",
      "type": "object"
    },
    "AdapterReleaseGateSignature": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "rolo-adapter-release-gate-signature/v1",
          "default": "rolo-adapter-release-gate-signature/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "algorithm": {
          "const": "Ed25519",
          "default": "Ed25519",
          "title": "Algorithm",
          "type": "string"
        },
        "key_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Key Id",
          "type": "string"
        },
        "receipt_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Receipt Sha256",
          "type": "string"
        },
        "signature_base64": {
          "pattern": "^[A-Za-z0-9+/]{86}==$",
          "title": "Signature Base64",
          "type": "string"
        }
      },
      "required": [
        "key_id",
        "receipt_sha256",
        "signature_base64"
      ],
      "title": "AdapterReleaseGateSignature",
      "type": "object"
    },
    "ApprovalAction": {
      "enum": [
        "ACCEPT_HOST_KEY",
        "INSTALL_TARGET_RUNTIME",
        "USE_SUDO",
        "REPLACE_ENROLLMENT",
        "UPGRADE_TARGET_RUNTIME",
        "ACTIVATE_RELEASE",
        "ROLLBACK_RELEASE",
        "ROLLBACK_TARGET_RUNTIME",
        "ROLLBACK_HOST_CONFIGURATION",
        "START_TARGET_SERVICE",
        "RECONCILE_TARGET_SERVICE",
        "STAGE_RELEASE",
        "DESCRIBE_RELEASE",
        "READ_PROJECT_EVIDENCE",
        "ANALYZE_PROJECT_SOURCE",
        "COLLECT_RUNTIME_EVIDENCE",
        "RAW_SSH_EXPERT_MODE"
      ],
      "title": "ApprovalAction",
      "type": "string"
    },
    "DeploymentAuthorizationGrant": {
      "additionalProperties": false,
      "description": "Short-lived controller capability verified against a target-local key pin.",
      "properties": {
        "schema_version": {
          "const": "rolo-deployment-authorization-grant/v1",
          "default": "rolo-deployment-authorization-grant/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "authorization_id": {
          "pattern": "^authorization-[0-9a-f]{32}$",
          "title": "Authorization Id",
          "type": "string"
        },
        "approval_id": {
          "pattern": "^approval-[0-9a-f]{32}$",
          "title": "Approval Id",
          "type": "string"
        },
        "decision_id": {
          "pattern": "^decision-[0-9a-f]{32}$",
          "title": "Decision Id",
          "type": "string"
        },
        "job_id": {
          "pattern": "^deployment-[0-9a-f]{32}$",
          "title": "Job Id",
          "type": "string"
        },
        "target_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Target Id",
          "type": "string"
        },
        "command_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Command Sha256",
          "type": "string"
        },
        "action": {
          "$ref": "#/$defs/ApprovalAction"
        },
        "approver_principal": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
          "title": "Approver Principal",
          "type": "string"
        },
        "request_schema_version": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$",
          "title": "Request Schema Version",
          "type": "string"
        },
        "request_payload_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Payload Sha256",
          "type": "string"
        },
        "issued_at": {
          "format": "date-time",
          "title": "Issued At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        }
      },
      "required": [
        "authorization_id",
        "approval_id",
        "decision_id",
        "job_id",
        "target_id",
        "command_sha256",
        "action",
        "approver_principal",
        "request_schema_version",
        "request_payload_sha256",
        "issued_at",
        "expires_at"
      ],
      "title": "DeploymentAuthorizationGrant",
      "type": "object"
    },
    "DeploymentAuthorizationProof": {
      "additionalProperties": false,
      "description": "Portable proof; the verification key is deliberately not part of the request.",
      "properties": {
        "schema_version": {
          "const": "rolo-deployment-authorization-proof/v1",
          "default": "rolo-deployment-authorization-proof/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "grant": {
          "$ref": "#/$defs/DeploymentAuthorizationGrant"
        },
        "signature": {
          "$ref": "#/$defs/DeploymentAuthorizationSignature"
        }
      },
      "required": [
        "grant",
        "signature"
      ],
      "title": "DeploymentAuthorizationProof",
      "type": "object"
    },
    "DeploymentAuthorizationSignature": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "rolo-deployment-authorization-signature/v1",
          "default": "rolo-deployment-authorization-signature/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "key_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Key Id",
          "type": "string"
        },
        "grant_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Grant Sha256",
          "type": "string"
        },
        "signature_base64": {
          "pattern": "^[A-Za-z0-9+/]{86}==$",
          "title": "Signature Base64",
          "type": "string"
        }
      },
      "required": [
        "key_id",
        "grant_sha256",
        "signature_base64"
      ],
      "title": "DeploymentAuthorizationSignature",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "rolo-adapter-release-activation-request/v1",
      "default": "rolo-adapter-release-activation-request/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "request_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Request Id",
      "type": "string"
    },
    "operation": {
      "$ref": "#/$defs/AdapterReleaseActivationOperation"
    },
    "target_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Target Id",
      "type": "string"
    },
    "robot_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Robot Id",
      "type": "string"
    },
    "release_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Release Id",
      "type": "string"
    },
    "transfer_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Transfer Manifest Sha256",
      "type": "string"
    },
    "signing_key_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Signing Key Id",
      "type": "string"
    },
    "signing_public_key_base64": {
      "maxLength": 32768,
      "title": "Signing Public Key Base64",
      "type": "string"
    },
    "signing_public_key_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Signing Public Key Sha256",
      "type": "string"
    },
    "approval_id": {
      "pattern": "^approval-[0-9a-f]{32}$",
      "title": "Approval Id",
      "type": "string"
    },
    "authorization": {
      "anyOf": [
        {
          "$ref": "#/$defs/DeploymentAuthorizationProof"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "gate_receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/AdapterReleaseGateReceipt"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "gate_signature": {
      "anyOf": [
        {
          "$ref": "#/$defs/AdapterReleaseGateSignature"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "expect_current_present": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expect Current Present"
    },
    "expected_current_transfer_manifest_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Current Transfer Manifest Sha256"
    }
  },
  "required": [
    "request_id",
    "operation",
    "target_id",
    "robot_id",
    "release_id",
    "transfer_manifest_sha256",
    "signing_key_id",
    "signing_public_key_base64",
    "signing_public_key_sha256",
    "approval_id"
  ],
  "title": "AdapterReleaseActivationRequest",
  "type": "object"
}