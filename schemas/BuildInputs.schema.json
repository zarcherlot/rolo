{
  "$defs": {
    "AgentRequirement": {
      "enum": [
        "coding_agent",
        "diagnosis_agent",
        "test_agent"
      ],
      "title": "AgentRequirement",
      "type": "string"
    },
    "BuildInputsStatus": {
      "enum": [
        "READY_FOR_CODING",
        "DEGRADED",
        "BLOCKED"
      ],
      "title": "BuildInputsStatus",
      "type": "string"
    }
  },
  "properties": {
    "schema_version": {
      "default": "robot-build-inputs/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "stage": {
      "default": "build",
      "title": "Stage",
      "type": "string"
    },
    "robot_id": {
      "title": "Robot Id",
      "type": "string"
    },
    "discovery_id": {
      "title": "Discovery Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/BuildInputsStatus"
    },
    "capability_manifest_ref": {
      "title": "Capability Manifest Ref",
      "type": "string"
    },
    "semantic_bindings_ref": {
      "title": "Semantic Bindings Ref",
      "type": "string"
    },
    "tool_catalog_ref": {
      "title": "Tool Catalog Ref",
      "type": "string"
    },
    "probe_refs": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Probe Refs",
      "type": "object"
    },
    "semantic_binding_candidates": {
      "default": 0,
      "title": "Semantic Binding Candidates",
      "type": "integer"
    },
    "tool_count": {
      "default": 0,
      "title": "Tool Count",
      "type": "integer"
    },
    "unresolved_dependencies": {
      "items": {
        "type": "string"
      },
      "title": "Unresolved Dependencies",
      "type": "array"
    },
    "agent_requirement": {
      "$ref": "#/$defs/AgentRequirement",
      "default": "coding_agent"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "robot_id",
    "discovery_id",
    "status",
    "capability_manifest_ref",
    "semantic_bindings_ref",
    "tool_catalog_ref",
    "probe_refs"
  ],
  "title": "BuildInputs",
  "type": "object"
}