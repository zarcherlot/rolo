{
  "$defs": {
    "TargetHostServiceError": {
      "enum": [
        "CANCELLED",
        "CONNECTION_FAILED",
        "CREDENTIAL_UNAVAILABLE",
        "HOST_PLAN_MISMATCH",
        "INVALID_REQUEST",
        "PROTOCOL_ERROR",
        "RUNTIME_MISMATCH",
        "SUDO_UNAVAILABLE",
        "SYSTEMD_FAILED"
      ],
      "title": "TargetHostServiceError",
      "type": "string"
    },
    "TargetHostServiceExecutionResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "rolo-target-host-service-execution-result/v1",
          "default": "rolo-target-host-service-execution-result/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "request_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Request Id",
          "type": "string"
        },
        "request_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Sha256",
          "type": "string"
        },
        "target_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Target Id",
          "type": "string"
        },
        "operation": {
          "$ref": "#/$defs/TargetHostServiceOperation"
        },
        "executor_kind": {
          "const": "SSH",
          "default": "SSH",
          "title": "Executor Kind",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/TargetHostServiceStatus"
        },
        "active": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active"
        },
        "error_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetHostServiceError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "observed_host_plan_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Host Plan Sha256"
        },
        "observed_runtime_manifest_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed Runtime Manifest Sha256"
        },
        "started_at": {
          "format": "date-time",
          "title": "Started At",
          "type": "string"
        },
        "finished_at": {
          "format": "date-time",
          "title": "Finished At",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "request_sha256",
        "target_id",
        "operation",
        "status",
        "started_at",
        "finished_at"
      ],
      "title": "TargetHostServiceExecutionResult",
      "type": "object"
    },
    "TargetHostServiceOperation": {
      "enum": [
        "START",
        "STATUS"
      ],
      "title": "TargetHostServiceOperation",
      "type": "string"
    },
    "TargetHostServiceStatus": {
      "enum": [
        "STARTED",
        "ALREADY_ACTIVE",
        "ACTIVE",
        "INACTIVE",
        "FAILED"
      ],
      "title": "TargetHostServiceStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "rolo-target-host-service-job-artifact/v1",
      "default": "rolo-target-host-service-job-artifact/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "pattern": "^deployment-[0-9a-f]{32}$",
      "title": "Job Id",
      "type": "string"
    },
    "command_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Command Sha256",
      "type": "string"
    },
    "spec_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Spec Sha256",
      "type": "string"
    },
    "target_id": {
      "title": "Target Id",
      "type": "string"
    },
    "execution": {
      "$ref": "#/$defs/TargetHostServiceExecutionResult"
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "command_sha256",
    "spec_sha256",
    "target_id",
    "execution",
    "completed_at"
  ],
  "title": "TargetHostServiceJobArtifact",
  "type": "object"
}