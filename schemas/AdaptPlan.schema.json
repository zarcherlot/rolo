{
  "$defs": {
    "AdaptPlanStatus": {
      "enum": [
        "BLOCKED",
        "REQUIRES_CODING"
      ],
      "title": "AdaptPlanStatus",
      "type": "string"
    },
    "AdaptTask": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "operations": {
          "items": {
            "type": "string"
          },
          "title": "Operations",
          "type": "array"
        },
        "agent_requirement": {
          "$ref": "#/$defs/AgentRequirement",
          "default": "adapter_agent"
        }
      },
      "required": [
        "id",
        "description"
      ],
      "title": "AdaptTask",
      "type": "object"
    },
    "AdapterAgentConfig": {
      "description": "Secret-free provider selection persisted with a Stage 1 Adapt plan.",
      "properties": {
        "provider": {
          "default": "codex",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Provider",
          "type": "string"
        },
        "executor": {
          "default": "codex",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Executor",
          "type": "string"
        },
        "base_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Url"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "api_key_env": {
          "default": "CODING_AGENT_API_KEY",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "title": "Api Key Env",
          "type": "string"
        },
        "api_key_configured": {
          "default": false,
          "title": "Api Key Configured",
          "type": "boolean"
        },
        "auto_install": {
          "default": true,
          "title": "Auto Install",
          "type": "boolean"
        },
        "require_auth": {
          "default": true,
          "title": "Require Auth",
          "type": "boolean"
        }
      },
      "title": "AdapterAgentConfig",
      "type": "object"
    },
    "AgentRequirement": {
      "enum": [
        "adapter_agent",
        "diagnosis_agent",
        "verification_agent"
      ],
      "title": "AgentRequirement",
      "type": "string"
    }
  },
  "properties": {
    "schema_version": {
      "default": "robot-adapt-plan/v3",
      "enum": [
        "robot-adapt-plan/v2",
        "robot-adapt-plan/v3"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "stage": {
      "default": "adapt",
      "title": "Stage",
      "type": "string"
    },
    "robot_id": {
      "title": "Robot Id",
      "type": "string"
    },
    "source_discovery_id": {
      "title": "Source Discovery Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/AdaptPlanStatus"
    },
    "tasks": {
      "items": {
        "$ref": "#/$defs/AdaptTask"
      },
      "title": "Tasks",
      "type": "array"
    },
    "eligible_operations": {
      "items": {
        "type": "string"
      },
      "title": "Eligible Operations",
      "type": "array"
    },
    "deferred_operations": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Deferred Operations",
      "type": "object"
    },
    "adapter_agent": {
      "$ref": "#/$defs/AdapterAgentConfig"
    },
    "semantic_context_ref": {
      "default": "",
      "title": "Semantic Context Ref",
      "type": "string"
    },
    "robot_wiki_ref": {
      "default": "",
      "title": "Robot Wiki Ref",
      "type": "string"
    },
    "discovery_manifest_ref": {
      "default": "",
      "title": "Discovery Manifest Ref",
      "type": "string"
    },
    "discovery_manifest_sha256": {
      "default": "",
      "title": "Discovery Manifest Sha256",
      "type": "string"
    },
    "heuristic_analysis_ref": {
      "default": "",
      "title": "Heuristic Analysis Ref",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "robot_id",
    "source_discovery_id",
    "status",
    "tasks"
  ],
  "title": "AdaptPlan",
  "type": "object"
}