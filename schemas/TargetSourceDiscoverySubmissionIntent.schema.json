{
  "$defs": {
    "TargetSourceDiscoveryJobSpec": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "rolo-target-source-discovery-job-spec/v1",
          "default": "rolo-target-source-discovery-job-spec/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "target_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Target Id",
          "type": "string"
        },
        "target_transport": {
          "$ref": "#/$defs/TargetTransport"
        },
        "target_registration_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Target Registration Sha256",
          "type": "string"
        },
        "workspace": {
          "$ref": "#/$defs/TargetWorkspaceRef"
        },
        "scan_roots": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Scan Roots",
          "type": "array"
        },
        "limits": {
          "$ref": "#/$defs/TargetSourceDiscoveryLimits"
        },
        "approval_id": {
          "pattern": "^approval-[0-9a-f]{32}$",
          "title": "Approval Id",
          "type": "string"
        },
        "approval_action": {
          "const": "ANALYZE_PROJECT_SOURCE",
          "default": "ANALYZE_PROJECT_SOURCE",
          "title": "Approval Action",
          "type": "string"
        },
        "approver_principal": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
          "title": "Approver Principal",
          "type": "string"
        },
        "approval_expires_at": {
          "format": "date-time",
          "title": "Approval Expires At",
          "type": "string"
        },
        "timeout_s": {
          "default": 120.0,
          "maximum": 300.0,
          "minimum": 1.0,
          "title": "Timeout S",
          "type": "number"
        }
      },
      "required": [
        "target_id",
        "target_transport",
        "target_registration_sha256",
        "workspace",
        "scan_roots",
        "limits",
        "approval_id",
        "approver_principal",
        "approval_expires_at"
      ],
      "title": "TargetSourceDiscoveryJobSpec",
      "type": "object"
    },
    "TargetSourceDiscoveryLimits": {
      "additionalProperties": false,
      "description": "The exact v1 parser budget; literals prevent a request from overstating limits.",
      "properties": {
        "max_projects": {
          "const": 16,
          "default": 16,
          "title": "Max Projects",
          "type": "integer"
        },
        "max_files_per_project": {
          "const": 10000,
          "default": 10000,
          "title": "Max Files Per Project",
          "type": "integer"
        },
        "max_file_read_bytes": {
          "const": 2000000,
          "default": 2000000,
          "title": "Max File Read Bytes",
          "type": "integer"
        },
        "max_items_per_collection": {
          "const": 1000,
          "default": 1000,
          "title": "Max Items Per Collection",
          "type": "integer"
        }
      },
      "title": "TargetSourceDiscoveryLimits",
      "type": "object"
    },
    "TargetTransport": {
      "enum": [
        "LOCAL",
        "SSH"
      ],
      "title": "TargetTransport",
      "type": "string"
    },
    "TargetWorkspaceRef": {
      "additionalProperties": false,
      "description": "A controller-safe reference to a workspace that exists on one target.",
      "properties": {
        "schema_version": {
          "const": "rolo-target-workspace-ref/v1",
          "default": "rolo-target-workspace-ref/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "workspace_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Workspace Id",
          "type": "string"
        },
        "target_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Target Id",
          "type": "string"
        },
        "robot_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Robot Id",
          "type": "string"
        },
        "root": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Root",
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "target_id",
        "robot_id",
        "root"
      ],
      "title": "TargetWorkspaceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "rolo-target-source-discovery-intent/v1",
      "default": "rolo-target-source-discovery-intent/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "target_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Target Id",
      "type": "string"
    },
    "requested_by": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
      "title": "Requested By",
      "type": "string"
    },
    "idempotency_key": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{7,127}$",
      "title": "Idempotency Key",
      "type": "string"
    },
    "submission_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Submission Sha256",
      "type": "string"
    },
    "spec": {
      "$ref": "#/$defs/TargetSourceDiscoveryJobSpec"
    }
  },
  "required": [
    "target_id",
    "requested_by",
    "idempotency_key",
    "submission_sha256",
    "spec"
  ],
  "title": "TargetSourceDiscoverySubmissionIntent",
  "type": "object"
}