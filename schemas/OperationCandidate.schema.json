{
  "$defs": {
    "RouteEvidence": {
      "additionalProperties": false,
      "description": "One stable, typed operation route observed or declared during discovery.",
      "properties": {
        "schema_version": {
          "const": "robot-route-evidence/v2",
          "default": "robot-route-evidence/v2",
          "title": "Schema Version",
          "type": "string"
        },
        "resource_id": {
          "minLength": 1,
          "title": "Resource Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "ros_topic",
            "ros_service",
            "ros_action",
            "device",
            "cli"
          ],
          "title": "Kind",
          "type": "string"
        },
        "endpoint": {
          "minLength": 1,
          "title": "Endpoint",
          "type": "string"
        },
        "interface_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interface Type"
        },
        "interface_schema_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Interface Schema Sha256"
        },
        "provider_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Id"
        },
        "runtime_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Runtime Revision"
        },
        "observed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Observed At"
        },
        "evidence_origin": {
          "enum": [
            "OBSERVED_RUNTIME",
            "DECLARED_STATIC"
          ],
          "title": "Evidence Origin",
          "type": "string"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "limitations": {
          "items": {
            "type": "string"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "resource_id",
        "kind",
        "endpoint",
        "evidence_origin",
        "source"
      ],
      "title": "RouteEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Untrusted applicability and binding evidence from discovery.",
  "properties": {
    "operation": {
      "title": "Operation",
      "type": "string"
    },
    "semantic_bindings": {
      "items": {
        "type": "string"
      },
      "title": "Semantic Bindings",
      "type": "array"
    },
    "evidence": {
      "items": {
        "type": "string"
      },
      "title": "Evidence",
      "type": "array"
    },
    "route_evidence": {
      "items": {
        "$ref": "#/$defs/RouteEvidence"
      },
      "title": "Route Evidence",
      "type": "array"
    },
    "executable_ids": {
      "items": {
        "type": "string"
      },
      "title": "Executable Ids",
      "type": "array"
    },
    "hardware_resource_ids": {
      "items": {
        "type": "string"
      },
      "title": "Hardware Resource Ids",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    },
    "status": {
      "const": "DISCOVERED_UNVERIFIED",
      "default": "DISCOVERED_UNVERIFIED",
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "operation"
  ],
  "title": "OperationCandidate",
  "type": "object"
}