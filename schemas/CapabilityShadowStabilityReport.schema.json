{
  "$defs": {
    "CapabilityShadowRunObservation": {
      "additionalProperties": false,
      "description": "One immutable capability-resolution shadow artifact summarized for review.",
      "properties": {
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "artifact_ref": {
          "title": "Artifact Ref",
          "type": "string"
        },
        "profile_id": {
          "title": "Profile Id",
          "type": "string"
        },
        "resolution_count": {
          "minimum": 0,
          "title": "Resolution Count",
          "type": "integer"
        },
        "resolved_count": {
          "minimum": 0,
          "title": "Resolved Count",
          "type": "integer"
        },
        "unavailable_count": {
          "minimum": 0,
          "title": "Unavailable Count",
          "type": "integer"
        },
        "ambiguous_count": {
          "minimum": 0,
          "title": "Ambiguous Count",
          "type": "integer"
        }
      },
      "required": [
        "run_id",
        "artifact_ref",
        "profile_id",
        "resolution_count",
        "resolved_count",
        "unavailable_count",
        "ambiguous_count"
      ],
      "title": "CapabilityShadowRunObservation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Release-neutral aggregate for P2 capability resolver shadow runs.",
  "properties": {
    "schema_version": {
      "const": "robot-capability-resolution-stability/v1",
      "default": "robot-capability-resolution-stability/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "robot_id": {
      "title": "Robot Id",
      "type": "string"
    },
    "max_runs": {
      "exclusiveMinimum": 0,
      "title": "Max Runs",
      "type": "integer"
    },
    "observation_count": {
      "minimum": 0,
      "title": "Observation Count",
      "type": "integer"
    },
    "resolution_count": {
      "minimum": 0,
      "title": "Resolution Count",
      "type": "integer"
    },
    "status_counts": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Status Counts",
      "type": "object"
    },
    "ambiguous_count": {
      "minimum": 0,
      "title": "Ambiguous Count",
      "type": "integer"
    },
    "unavailable_count": {
      "minimum": 0,
      "title": "Unavailable Count",
      "type": "integer"
    },
    "resolved_count": {
      "minimum": 0,
      "title": "Resolved Count",
      "type": "integer"
    },
    "recommendation": {
      "enum": [
        "INSUFFICIENT_DATA",
        "HOLD",
        "READY_FOR_REVIEW"
      ],
      "title": "Recommendation",
      "type": "string"
    },
    "recommendation_reasons": {
      "items": {
        "type": "string"
      },
      "title": "Recommendation Reasons",
      "type": "array"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/CapabilityShadowRunObservation"
      },
      "title": "Observations",
      "type": "array"
    },
    "influences_release": {
      "const": false,
      "default": false,
      "title": "Influences Release",
      "type": "boolean"
    }
  },
  "required": [
    "robot_id",
    "max_runs",
    "observation_count",
    "resolution_count",
    "ambiguous_count",
    "unavailable_count",
    "resolved_count",
    "recommendation"
  ],
  "title": "CapabilityShadowStabilityReport",
  "type": "object"
}