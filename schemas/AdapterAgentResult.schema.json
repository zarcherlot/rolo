{
  "$defs": {
    "AdapterAgentFile": {
      "additionalProperties": false,
      "description": "Bounded file payload returned through Codex's structured final message.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "encoding": {
          "const": "base64",
          "title": "Encoding",
          "type": "string"
        },
        "content": {
          "maxLength": 24000000,
          "title": "Content",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "encoding",
        "content",
        "sha256"
      ],
      "title": "AdapterAgentFile",
      "type": "object"
    },
    "AdapterOutputRefs": {
      "additionalProperties": false,
      "description": "Workspace-relative outputs proposed for independent promotion.",
      "properties": {
        "adapter_manifest": {
          "title": "Adapter Manifest",
          "type": "string"
        },
        "adapter_package": {
          "title": "Adapter Package",
          "type": "string"
        },
        "state_graph": {
          "title": "State Graph",
          "type": "string"
        },
        "conformance_report": {
          "title": "Conformance Report",
          "type": "string"
        }
      },
      "required": [
        "adapter_manifest",
        "adapter_package",
        "state_graph",
        "conformance_report"
      ],
      "title": "AdapterOutputRefs",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Structured final message produced by the Stage 1 Adapter Agent.",
  "properties": {
    "schema_version": {
      "enum": [
        "robot-adapter-agent-result/v1",
        "robot-adapter-agent-result/v2"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "completed_tasks": {
      "items": {
        "type": "string"
      },
      "title": "Completed Tasks",
      "type": "array"
    },
    "changed_files": {
      "items": {
        "type": "string"
      },
      "title": "Changed Files",
      "type": "array"
    },
    "validation": {
      "items": {
        "type": "string"
      },
      "title": "Validation",
      "type": "array"
    },
    "blockers": {
      "items": {
        "type": "string"
      },
      "title": "Blockers",
      "type": "array"
    },
    "handoff_ready": {
      "title": "Handoff Ready",
      "type": "boolean"
    },
    "outputs": {
      "anyOf": [
        {
          "$ref": "#/$defs/AdapterOutputRefs"
        },
        {
          "type": "null"
        }
      ]
    },
    "files": {
      "items": {
        "$ref": "#/$defs/AdapterAgentFile"
      },
      "title": "Files",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "summary",
    "completed_tasks",
    "changed_files",
    "validation",
    "blockers",
    "handoff_ready",
    "outputs",
    "files"
  ],
  "title": "AdapterAgentResult",
  "type": "object"
}