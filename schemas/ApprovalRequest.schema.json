{
  "$defs": {
    "ApprovalAction": {
      "enum": [
        "ACCEPT_HOST_KEY",
        "INSTALL_TARGET_RUNTIME",
        "USE_SUDO",
        "REPLACE_ENROLLMENT",
        "UPGRADE_TARGET_RUNTIME",
        "ACTIVATE_RELEASE",
        "ROLLBACK_RELEASE",
        "ROLLBACK_TARGET_RUNTIME",
        "ROLLBACK_HOST_CONFIGURATION",
        "START_TARGET_SERVICE",
        "RECONCILE_TARGET_SERVICE",
        "STAGE_RELEASE",
        "DESCRIBE_RELEASE",
        "READ_PROJECT_EVIDENCE",
        "ANALYZE_PROJECT_SOURCE",
        "COLLECT_RUNTIME_EVIDENCE",
        "RAW_SSH_EXPERT_MODE"
      ],
      "title": "ApprovalAction",
      "type": "string"
    },
    "ApprovalStatus": {
      "enum": [
        "PENDING",
        "APPROVED",
        "REJECTED",
        "EXPIRED"
      ],
      "title": "ApprovalStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "rolo-approval-request/v1",
      "default": "rolo-approval-request/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "approval_id": {
      "pattern": "^approval-[0-9a-f]{32}$",
      "title": "Approval Id",
      "type": "string"
    },
    "job_id": {
      "pattern": "^deployment-[0-9a-f]{32}$",
      "title": "Job Id",
      "type": "string"
    },
    "target_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Target Id",
      "type": "string"
    },
    "command_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Command Sha256",
      "type": "string"
    },
    "authorization_scope_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Authorization Scope Sha256"
    },
    "requester_principal": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
      "title": "Requester Principal",
      "type": "string"
    },
    "approver_principal": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
      "title": "Approver Principal",
      "type": "string"
    },
    "action": {
      "$ref": "#/$defs/ApprovalAction"
    },
    "risk": {
      "enum": [
        "R1",
        "R2",
        "R3"
      ],
      "title": "Risk",
      "type": "string"
    },
    "sanitized_summary": {
      "maxLength": 1000,
      "minLength": 1,
      "title": "Sanitized Summary",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ApprovalStatus",
      "default": "PENDING"
    },
    "requested_at": {
      "format": "date-time",
      "title": "Requested At",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    }
  },
  "required": [
    "approval_id",
    "job_id",
    "target_id",
    "command_sha256",
    "requester_principal",
    "approver_principal",
    "action",
    "risk",
    "sanitized_summary",
    "requested_at",
    "expires_at"
  ],
  "title": "ApprovalRequest",
  "type": "object"
}