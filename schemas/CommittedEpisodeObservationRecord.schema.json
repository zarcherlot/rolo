{
  "$defs": {
    "EpisodeObservationProducerBundle": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "rolo-episode-observation-producer-bundle/v1",
          "default": "rolo-episode-observation-producer-bundle/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "bundle_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Bundle Id",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "parent_bundle_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Bundle Id"
        },
        "trigger_kind": {
          "$ref": "#/$defs/ObservationBundleTrigger"
        },
        "status": {
          "$ref": "#/$defs/ObservationBundleStatus"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "window_start_offset_ms": {
          "minimum": 0,
          "title": "Window Start Offset Ms",
          "type": "integer"
        },
        "window_end_offset_ms": {
          "exclusiveMinimum": 0,
          "title": "Window End Offset Ms",
          "type": "integer"
        },
        "synchronization": {
          "$ref": "#/$defs/EpisodeSynchronization"
        },
        "spatial_alignment": {
          "$ref": "#/$defs/ObservationSpatialAlignment"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/EpisodeObservationProducerSource"
          },
          "maxItems": 64,
          "title": "Sources",
          "type": "array"
        },
        "evidence_refs": {
          "items": {
            "maxLength": 1024,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 256,
          "title": "Evidence Refs",
          "type": "array"
        },
        "public_limitations": {
          "items": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "title": "Public Limitations",
          "type": "array"
        },
        "raw_context": {
          "additionalProperties": true,
          "title": "Raw Context",
          "type": "object"
        },
        "influences_verification": {
          "const": false,
          "default": false,
          "title": "Influences Verification",
          "type": "boolean"
        }
      },
      "required": [
        "bundle_id",
        "sequence",
        "trigger_kind",
        "status",
        "created_at",
        "window_start_offset_ms",
        "window_end_offset_ms",
        "synchronization",
        "spatial_alignment"
      ],
      "title": "EpisodeObservationProducerBundle",
      "type": "object"
    },
    "EpisodeObservationProducerSource": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "rolo-episode-observation-producer-source/v1",
          "default": "rolo-episode-observation-producer-source/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Source Id",
          "type": "string"
        },
        "public_label": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Public Label",
          "type": "string"
        },
        "source_kind": {
          "$ref": "#/$defs/ObservationSourceKind"
        },
        "modality": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Modality",
          "type": "string"
        },
        "world_kind": {
          "$ref": "#/$defs/EpisodeWorldKind"
        },
        "availability": {
          "$ref": "#/$defs/ObservationSourceAvailability"
        },
        "synchronization": {
          "$ref": "#/$defs/EpisodeSynchronization"
        },
        "spatial_alignment": {
          "$ref": "#/$defs/ObservationSpatialAlignment"
        },
        "asset_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "maxItems": 256,
          "title": "Asset Ids",
          "type": "array"
        },
        "public_limitations": {
          "items": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "title": "Public Limitations",
          "type": "array"
        },
        "provider_identity": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Identity"
        },
        "topic_name": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Topic Name"
        },
        "device_path": {
          "anyOf": [
            {
              "maxLength": 1024,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Device Path"
        },
        "internal_metadata": {
          "additionalProperties": true,
          "title": "Internal Metadata",
          "type": "object"
        }
      },
      "required": [
        "source_id",
        "public_label",
        "source_kind",
        "modality",
        "world_kind",
        "availability",
        "synchronization",
        "spatial_alignment"
      ],
      "title": "EpisodeObservationProducerSource",
      "type": "object"
    },
    "EpisodeSynchronization": {
      "enum": [
        "SYNCED",
        "DEGRADED",
        "UNSYNCED",
        "UNKNOWN"
      ],
      "title": "EpisodeSynchronization",
      "type": "string"
    },
    "EpisodeWorldKind": {
      "enum": [
        "PHYSICAL",
        "SIMULATED",
        "REPLAYED"
      ],
      "title": "EpisodeWorldKind",
      "type": "string"
    },
    "ObservationBundleStatus": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "UNAVAILABLE"
      ],
      "title": "ObservationBundleStatus",
      "type": "string"
    },
    "ObservationBundleTrigger": {
      "enum": [
        "INITIAL",
        "SUPPLEMENTARY"
      ],
      "title": "ObservationBundleTrigger",
      "type": "string"
    },
    "ObservationSourceAvailability": {
      "enum": [
        "AVAILABLE",
        "MISSING",
        "STALE",
        "REJECTED",
        "UNAVAILABLE"
      ],
      "title": "ObservationSourceAvailability",
      "type": "string"
    },
    "ObservationSourceKind": {
      "enum": [
        "ONBOARD_SENSOR",
        "EXTERNAL_MEASUREMENT",
        "ROBOT_STATE",
        "SPATIAL_MODEL",
        "DETERMINISTIC_RENDER",
        "TRUSTED_GUI_CAPTURE",
        "SIMULATION"
      ],
      "title": "ObservationSourceKind",
      "type": "string"
    },
    "ObservationSpatialAlignment": {
      "enum": [
        "ALIGNED",
        "DEGRADED",
        "UNALIGNED",
        "UNKNOWN"
      ],
      "title": "ObservationSpatialAlignment",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "rolo-episode-observation-producer-record/v1",
      "default": "rolo-episode-observation-producer-record/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "robot_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Robot Id",
      "type": "string"
    },
    "episode_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Episode Id",
      "type": "string"
    },
    "episode_revision": {
      "minimum": 1,
      "title": "Episode Revision",
      "type": "integer"
    },
    "record_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Record Id",
      "type": "string"
    },
    "committed": {
      "const": true,
      "title": "Committed",
      "type": "boolean"
    },
    "committed_at": {
      "format": "date-time",
      "title": "Committed At",
      "type": "string"
    },
    "producer": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Producer",
      "type": "string"
    },
    "bundles": {
      "items": {
        "$ref": "#/$defs/EpisodeObservationProducerBundle"
      },
      "maxItems": 100,
      "title": "Bundles",
      "type": "array"
    },
    "public_limitations": {
      "items": {
        "maxLength": 1000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 32,
      "title": "Public Limitations",
      "type": "array"
    },
    "content_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    }
  },
  "required": [
    "robot_id",
    "episode_id",
    "episode_revision",
    "record_id",
    "committed",
    "committed_at",
    "producer",
    "content_sha256"
  ],
  "title": "CommittedEpisodeObservationRecord",
  "type": "object"
}
