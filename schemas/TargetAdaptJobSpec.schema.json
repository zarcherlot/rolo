{
  "$defs": {
    "AdaptStartParameters": {
      "additionalProperties": false,
      "description": "Typed execution parameters with an explicit controller/target path location.",
      "properties": {
        "schema_version": {
          "default": "rolo-adapt-start-parameters/v2",
          "enum": [
            "rolo-adapt-start-parameters/v1",
            "rolo-adapt-start-parameters/v2"
          ],
          "title": "Schema Version",
          "type": "string"
        },
        "project_root_location": {
          "default": "CONTROLLER",
          "enum": [
            "CONTROLLER",
            "TARGET"
          ],
          "title": "Project Root Location",
          "type": "string"
        },
        "project_root": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Project Root",
          "type": "string"
        },
        "urdf_path": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Urdf Path"
        },
        "scratch_root": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scratch Root"
        },
        "timeout_s": {
          "maximum": 86400,
          "minimum": 1,
          "title": "Timeout S",
          "type": "integer"
        },
        "evidence_mode": {
          "default": "local",
          "enum": [
            "local",
            "remote"
          ],
          "title": "Evidence Mode",
          "type": "string"
        },
        "allowed_executables": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Allowed Executables",
          "type": "array"
        },
        "collector_descriptor_path": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Collector Descriptor Path"
        },
        "verification_secret_ref": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verification Secret Ref"
        },
        "ssh_target": {
          "anyOf": [
            {
              "maxLength": 253,
              "minLength": 1,
              "pattern": "^(?:[A-Za-z0-9_.-]+@)?[A-Za-z0-9_.-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ssh Target"
        },
        "known_hosts_path": {
          "anyOf": [
            {
              "maxLength": 4096,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Known Hosts Path"
        },
        "collector_config": {
          "default": ".rolo/config/target-evidence-collector.json",
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "^[/A-Za-z0-9_.-]+$",
          "title": "Collector Config",
          "type": "string"
        },
        "evidence_timeout_s": {
          "default": 45.0,
          "maximum": 300.0,
          "minimum": 1.0,
          "title": "Evidence Timeout S",
          "type": "number"
        }
      },
      "required": [
        "project_root",
        "timeout_s"
      ],
      "title": "AdaptStartParameters",
      "type": "object"
    },
    "TargetAdaptProjectEvidenceBinding": {
      "additionalProperties": false,
      "description": "Immutable reference from one SSH Adapt Job to verified target metadata.",
      "properties": {
        "schema_version": {
          "const": "rolo-target-adapt-project-evidence-binding/v1",
          "default": "rolo-target-adapt-project-evidence-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "job_id": {
          "pattern": "^deployment-[0-9a-f]{32}$",
          "title": "Job Id",
          "type": "string"
        },
        "artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        },
        "command_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Command Sha256",
          "type": "string"
        },
        "target_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Target Id",
          "type": "string"
        },
        "target_registration_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Target Registration Sha256",
          "type": "string"
        },
        "workspace_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Workspace Sha256",
          "type": "string"
        },
        "workspace_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Workspace Manifest Sha256",
          "type": "string"
        },
        "observed_paths": {
          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Observed Paths",
          "type": "array"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "artifact_sha256",
        "command_sha256",
        "target_id",
        "target_registration_sha256",
        "workspace_sha256",
        "workspace_manifest_sha256",
        "observed_paths",
        "observed_at",
        "expires_at"
      ],
      "title": "TargetAdaptProjectEvidenceBinding",
      "type": "object"
    },
    "TargetAdaptRuntimeEvidenceBinding": {
      "additionalProperties": false,
      "description": "Immutable reference to separately approved, signed runtime facts.",
      "properties": {
        "schema_version": {
          "const": "rolo-target-adapt-runtime-evidence-binding/v1",
          "default": "rolo-target-adapt-runtime-evidence-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "job_id": {
          "pattern": "^deployment-[0-9a-f]{32}$",
          "title": "Job Id",
          "type": "string"
        },
        "artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        },
        "command_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Command Sha256",
          "type": "string"
        },
        "target_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Target Id",
          "type": "string"
        },
        "target_registration_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Target Registration Sha256",
          "type": "string"
        },
        "collector_id": {
          "pattern": "^collector-[0-9a-f]{32}$",
          "title": "Collector Id",
          "type": "string"
        },
        "collector_descriptor_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Collector Descriptor Sha256",
          "type": "string"
        },
        "collector_configuration_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Collector Configuration Sha256",
          "type": "string"
        },
        "collector_key_id": {
          "pattern": "^collector-key-[0-9a-f]{32}$",
          "title": "Collector Key Id",
          "type": "string"
        },
        "evidence_request_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Evidence Request Sha256",
          "type": "string"
        },
        "bundle_payload_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Bundle Payload Sha256",
          "type": "string"
        },
        "collected_at": {
          "format": "date-time",
          "title": "Collected At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "artifact_sha256",
        "command_sha256",
        "target_id",
        "target_registration_sha256",
        "collector_id",
        "collector_descriptor_sha256",
        "collector_configuration_sha256",
        "collector_key_id",
        "evidence_request_sha256",
        "bundle_payload_sha256",
        "collected_at",
        "expires_at"
      ],
      "title": "TargetAdaptRuntimeEvidenceBinding",
      "type": "object"
    },
    "TargetAdaptSourceDiscoveryBinding": {
      "additionalProperties": false,
      "description": "Immutable reference to separately approved target source-analysis facts.",
      "properties": {
        "schema_version": {
          "const": "rolo-target-adapt-source-discovery-binding/v1",
          "default": "rolo-target-adapt-source-discovery-binding/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "job_id": {
          "pattern": "^deployment-[0-9a-f]{32}$",
          "title": "Job Id",
          "type": "string"
        },
        "artifact_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Artifact Sha256",
          "type": "string"
        },
        "command_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Command Sha256",
          "type": "string"
        },
        "target_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Target Id",
          "type": "string"
        },
        "target_registration_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Target Registration Sha256",
          "type": "string"
        },
        "workspace_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Workspace Id",
          "type": "string"
        },
        "workspace_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Workspace Sha256",
          "type": "string"
        },
        "request_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Sha256",
          "type": "string"
        },
        "summary_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Summary Sha256",
          "type": "string"
        },
        "scan_roots": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Scan Roots",
          "type": "array"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        }
      },
      "required": [
        "job_id",
        "artifact_sha256",
        "command_sha256",
        "target_id",
        "target_registration_sha256",
        "workspace_id",
        "workspace_sha256",
        "request_sha256",
        "summary_sha256",
        "scan_roots",
        "observed_at",
        "expires_at"
      ],
      "title": "TargetAdaptSourceDiscoveryBinding",
      "type": "object"
    },
    "TargetTransport": {
      "enum": [
        "LOCAL",
        "SSH"
      ],
      "title": "TargetTransport",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "default": "rolo-target-adapt-job-spec/v4",
      "enum": [
        "rolo-target-adapt-job-spec/v1",
        "rolo-target-adapt-job-spec/v2",
        "rolo-target-adapt-job-spec/v3",
        "rolo-target-adapt-job-spec/v4"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "target_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Target Id",
      "type": "string"
    },
    "target_registration_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Target Registration Sha256",
      "type": "string"
    },
    "workspace_root": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Workspace Root",
      "type": "string"
    },
    "target_transport": {
      "$ref": "#/$defs/TargetTransport",
      "default": "LOCAL"
    },
    "project_evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/TargetAdaptProjectEvidenceBinding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "source_discovery": {
      "anyOf": [
        {
          "$ref": "#/$defs/TargetAdaptSourceDiscoveryBinding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "runtime_evidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/TargetAdaptRuntimeEvidenceBinding"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "parameters": {
      "$ref": "#/$defs/AdaptStartParameters"
    },
    "active_probe": {
      "enum": [
        "none",
        "help",
        "runtime-readonly"
      ],
      "title": "Active Probe",
      "type": "string"
    },
    "run_adapter_agent": {
      "const": false,
      "default": false,
      "title": "Run Adapter Agent",
      "type": "boolean"
    }
  },
  "required": [
    "target_id",
    "target_registration_sha256",
    "workspace_root",
    "parameters",
    "active_probe"
  ],
  "title": "TargetAdaptJobSpec",
  "type": "object"
}