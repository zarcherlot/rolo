      "type": "string"
    },
    "tool_catalog": {
      "title": "Tool Catalog",
      "type": "string"
    },
    "tool_catalog_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Tool Catalog Sha256",
      "type": "string"
    },
    "state_graph": {
      "title": "State Graph",
      "type": "string"
    },
    "state_graph_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "State Graph Sha256",
