{
  "$defs": {
    "PublishedAdapterFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "role": {
          "default": "SUPPORT",
          "enum": [
            "ENTRYPOINT",
            "SUPPORT"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "PublishedAdapterFile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Files published together after the independent Adapt gate passes.",
  "properties": {
    "schema_version": {
      "default": "robot-adapter-release/v2",
      "enum": [
        "robot-adapter-release/v1",
        "robot-adapter-release/v2"
      ],
      "title": "Schema Version",
      "type": "string"
    },
    "release_id": {
      "title": "Release Id",
      "type": "string"
    },
    "robot_id": {
      "title": "Robot Id",
      "type": "string"
    },
    "discovery_id": {
      "title": "Discovery Id",
      "type": "string"
    },
    "target_fingerprint_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Fingerprint Sha256"
    },
    "bundle_manifest": {
      "title": "Bundle Manifest",
      "type": "string"
    },
    "bundle_manifest_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Bundle Manifest Sha256",
      "type": "string"
    },
    "adapter_package": {
      "title": "Adapter Package",
      "type": "string"
    },
    "adapter_package_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Adapter Package Sha256",
      "type": "string"
    },
    "adapter_files": {
      "items": {
        "$ref": "#/$defs/PublishedAdapterFile"
      },
      "title": "Adapter Files",
      "type": "array"
    },
    "tool_catalog": {
      "title": "Tool Catalog",
      "type": "string"
    },
    "tool_catalog_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Tool Catalog Sha256",
      "type": "string"
    },
    "state_graph": {
      "title": "State Graph",
      "type": "string"
    },
    "state_graph_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "State Graph Sha256",
      "type": "string"
    },
    "conformance_report": {
      "title": "Conformance Report",
      "type": "string"
    },
    "conformance_report_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Conformance Report Sha256",
      "type": "string"
    },
    "gate_report": {
      "title": "Gate Report",
      "type": "string"
    },
    "gate_report_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Gate Report Sha256",
      "type": "string"
    },
    "published_at": {
      "format": "date-time",
      "title": "Published At",
      "type": "string"
    }
  },
  "required": [
    "release_id",
    "robot_id",
    "discovery_id",
    "bundle_manifest",
    "bundle_manifest_sha256",
    "adapter_package",
    "adapter_package_sha256",
    "tool_catalog",
    "tool_catalog_sha256",
    "state_graph",
    "state_graph_sha256",
    "conformance_report",
    "conformance_report_sha256",
    "gate_report",
    "gate_report_sha256"
  ],
  "title": "AdapterReleaseManifest",
  "type": "object"
}