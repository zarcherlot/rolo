  "required": [
    "request_id",
    "request_sha256",
    "target_id",
    "robot_id",
    "release_id",
    "package_id",
    "manifest_sha256",
    "signing_key_id",
    "signing_public_key_sha256",
    "status",
    "staged_root",
    "release_root",
