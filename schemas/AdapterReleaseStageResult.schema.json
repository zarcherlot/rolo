    "release_root": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Release Root",
      "type": "string"
    },
    "runtime_context_path": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Runtime Context Path",
      "type": "string"
    }
