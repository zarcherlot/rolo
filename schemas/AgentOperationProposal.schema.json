{
  "$defs": {
    "AgentDisposition": {
      "description": "Agent judgment over one deterministic semantic binding.\n\nThis is advisory until Rolo validates the referenced frozen evidence and\nany evidence-tool receipts.",
      "enum": [
        "ACCEPT",
        "DEFER",
        "REJECT"
      ],
      "title": "AgentDisposition",
      "type": "string"
    },
    "AgentEvidenceCondition": {
      "description": "Read-only facts that the mapping evidence tool can reproduce.",
      "enum": [
        "BINDING_MATCH",
        "ROUTE_OBSERVED",
        "INTERFACE_SCHEMA_KNOWN",
        "PROVIDER_IDENTIFIED",
        "RUNTIME_REVISION_KNOWN"
      ],
      "title": "AgentEvidenceCondition",
      "type": "string"
    },
    "AgentEvidenceToolReceipt": {
      "additionalProperties": false,
      "description": "Agent-returned receipt that Rolo independently recomputes.",
      "properties": {
        "receipt_id": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Receipt Id",
          "type": "string"
        },
        "operation": {
          "maxLength": 160,
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$",
          "title": "Operation",
          "type": "string"
        },
        "route_resource_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Route Resource Id",
          "type": "string"
        },
        "condition": {
          "$ref": "#/$defs/AgentEvidenceCondition"
        },
        "satisfied": {
          "title": "Satisfied",
          "type": "boolean"
        },
        "result_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Result Sha256",
          "type": "string"
        }
      },
      "required": [
        "receipt_id",
        "operation",
        "route_resource_id",
        "condition",
        "satisfied",
        "result_sha256"
      ],
      "title": "AgentEvidenceToolReceipt",
      "type": "object"
    },
    "AgentRouteDisposition": {
      "additionalProperties": false,
      "description": "Agent decision for exactly one route in a deterministic binding.",
      "properties": {
        "route_resource_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Route Resource Id",
          "type": "string"
        },
        "disposition": {
          "$ref": "#/$defs/AgentDisposition"
        },
        "rationale": {
          "maxLength": 1000,
          "minLength": 8,
          "title": "Rationale",
          "type": "string"
        },
        "tool_receipt_ids": {
          "items": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Tool Receipt Ids",
          "type": "array"
        }
      },
      "required": [
        "route_resource_id",
        "disposition",
        "rationale"
      ],
      "title": "AgentRouteDisposition",
      "type": "object"
    },
    "ProposalConfidence": {
      "enum": [
        "LOW",
        "MEDIUM"
      ],
      "title": "ProposalConfidence",
      "type": "string"
    },
    "VerificationRequest": {
      "additionalProperties": false,
      "description": "One deterministic follow-up requested by an untrusted mapping Agent.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/VerificationRequestKind"
        },
        "subject_ref": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Subject Ref",
          "type": "string"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 8,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "subject_ref",
        "reason"
      ],
      "title": "VerificationRequest",
      "type": "object"
    },
    "VerificationRequestKind": {
      "enum": [
        "ROUTE_OBSERVATION",
        "EXECUTABLE_INSPECTION",
        "HARDWARE_INSPECTION",
        "CONTRACT_REVIEW"
      ],
      "title": "VerificationRequestKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Untrusted mapping proposal that only references collected target evidence.",
  "properties": {
    "operation": {
      "maxLength": 160,
      "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$",
      "title": "Operation",
      "type": "string"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Evidence Refs",
      "type": "array"
    },
    "route_resource_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "title": "Route Resource Ids",
      "type": "array"
    },
    "executable_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "title": "Executable Ids",
      "type": "array"
    },
    "hardware_resource_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "title": "Hardware Resource Ids",
      "type": "array"
    },
    "confidence": {
      "$ref": "#/$defs/ProposalConfidence"
    },
    "disposition": {
      "$ref": "#/$defs/AgentDisposition",
      "default": "ACCEPT"
    },
    "rationale": {
      "maxLength": 2000,
      "minLength": 8,
      "title": "Rationale",
      "type": "string"
    },
    "route_dispositions": {
      "items": {
        "$ref": "#/$defs/AgentRouteDisposition"
      },
      "maxItems": 32,
      "title": "Route Dispositions",
      "type": "array"
    },
    "tool_receipts": {
      "items": {
        "$ref": "#/$defs/AgentEvidenceToolReceipt"
      },
      "maxItems": 128,
      "title": "Tool Receipts",
      "type": "array"
    },
    "counter_evidence_refs": {
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "title": "Counter Evidence Refs",
      "type": "array"
    },
    "requested_verification": {
      "items": {
        "$ref": "#/$defs/VerificationRequest"
      },
      "maxItems": 16,
      "title": "Requested Verification",
      "type": "array"
    }
  },
  "required": [
    "operation",
    "evidence_refs",
    "confidence",
    "rationale"
  ],
  "title": "AgentOperationProposal",
  "type": "object"
}
