{
  "$defs": {
    "CollectorConfigurationV4": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "robot-target-collector-configuration/v4",
          "default": "robot-target-collector-configuration/v4",
          "title": "Schema Version",
          "type": "string"
        },
        "help_executables": {
          "items": {
            "$ref": "#/$defs/CollectorHelpExecutable"
          },
          "maxItems": 4,
          "title": "Help Executables",
          "type": "array"
        },
        "ros_setup_files": {
          "items": {
            "$ref": "#/$defs/RosSetupFileRecord"
          },
          "maxItems": 8,
          "title": "Ros Setup Files",
          "type": "array"
        }
      },
      "title": "CollectorConfigurationV4",
      "type": "object"
    },
    "CollectorDescriptorV4": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "robot-target-evidence-collector/v4",
          "default": "robot-target-evidence-collector/v4",
          "title": "Schema Version",
          "type": "string"
        },
        "target_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Target Id",
          "type": "string"
        },
        "robot_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Robot Id",
          "type": "string"
        },
        "collector_id": {
          "pattern": "^collector-[0-9a-f]{32}$",
          "title": "Collector Id",
          "type": "string"
        },
        "target_host_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Target Host Fingerprint",
          "type": "string"
        },
        "key_id": {
          "pattern": "^collector-key-[0-9a-f]{32}$",
          "title": "Key Id",
          "type": "string"
        },
        "signing_algorithm": {
          "const": "Ed25519",
          "default": "Ed25519",
          "title": "Signing Algorithm",
          "type": "string"
        },
        "public_key_base64": {
          "pattern": "^[A-Za-z0-9+/]{43}=$",
          "title": "Public Key Base64",
          "type": "string"
        },
        "public_key_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Public Key Sha256",
          "type": "string"
        },
        "configuration_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Configuration Sha256",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "target_id",
        "robot_id",
        "collector_id",
        "target_host_fingerprint",
        "key_id",
        "public_key_base64",
        "public_key_sha256",
        "configuration_sha256",
        "created_at"
      ],
      "title": "CollectorDescriptorV4",
      "type": "object"
    },
    "CollectorHelpExecutable": {
      "additionalProperties": false,
      "properties": {
        "executable_id": {
          "pattern": "^target-exe-[0-9a-f]{24}$",
          "title": "Executable Id",
          "type": "string"
        },
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "executable_id",
        "path",
        "sha256"
      ],
      "title": "CollectorHelpExecutable",
      "type": "object"
    },
    "RosSetupFileRecord": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "kind": {
          "enum": [
            "BASE",
            "OVERLAY",
            "EXPLICIT"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "kind"
      ],
      "title": "RosSetupFileRecord",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "rolo-controller-collector-enrollment-pin/v4",
      "default": "rolo-controller-collector-enrollment-pin/v4",
      "title": "Schema Version",
      "type": "string"
    },
    "descriptor": {
      "$ref": "#/$defs/CollectorDescriptorV4"
    },
    "configuration": {
      "$ref": "#/$defs/CollectorConfigurationV4"
    },
    "descriptor_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Descriptor Sha256",
      "type": "string"
    },
    "source_request_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Source Request Id",
      "type": "string"
    },
    "source_request_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Source Request Sha256",
      "type": "string"
    },
    "approval_id": {
      "pattern": "^approval-[0-9a-f]{32}$",
      "title": "Approval Id",
      "type": "string"
    },
    "transition_id": {
      "anyOf": [
        {
          "pattern": "^transition-[0-9a-f]{32}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Transition Id"
    },
    "pinned_at": {
      "format": "date-time",
      "title": "Pinned At",
      "type": "string"
    }
  },
  "required": [
    "descriptor",
    "configuration",
    "descriptor_sha256",
    "source_request_id",
    "source_request_sha256",
    "approval_id",
    "pinned_at"
  ],
  "title": "CollectorEnrollmentPinV4",
  "type": "object"
}