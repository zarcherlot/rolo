{
  "$defs": {
    "EpisodeCoverage": {
      "enum": [
        "METADATA_ONLY",
        "PARTIAL",
        "COMPLETE"
      ],
      "title": "EpisodeCoverage",
      "type": "string"
    },
    "EpisodeOutcome": {
      "enum": [
        "SUCCEEDED",
        "FAILED",
        "CANCELLED",
        "UNKNOWN"
      ],
      "title": "EpisodeOutcome",
      "type": "string"
    },
    "EpisodeState": {
      "enum": [
        "RUNNING",
        "COMPLETED",
        "FAILED",
        "CANCELLED",
        "PARTIAL"
      ],
      "title": "EpisodeState",
      "type": "string"
    },
    "EpisodeVerification": {
      "enum": [
        "VERIFIED",
        "UNVERIFIED",
        "NOT_AVAILABLE"
      ],
      "title": "EpisodeVerification",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "rolo-episode-summary/v1",
      "default": "rolo-episode-summary/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "robot_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Robot Id",
      "type": "string"
    },
    "episode_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Episode Id",
      "type": "string"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "task_label": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Task Label",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/EpisodeState"
    },
    "outcome": {
      "$ref": "#/$defs/EpisodeOutcome"
    },
    "verification": {
      "$ref": "#/$defs/EpisodeVerification"
    },
    "coverage": {
      "$ref": "#/$defs/EpisodeCoverage"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "ended_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ended At"
    },
    "execution_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Execution Id"
    },
    "test_case_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Test Case Id"
    },
    "lifecycle_run_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lifecycle Run Id"
    },
    "operation": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Operation"
    },
    "event_count": {
      "minimum": 0,
      "title": "Event Count",
      "type": "integer"
    },
    "asset_count": {
      "minimum": 0,
      "title": "Asset Count",
      "type": "integer"
    },
    "finding_count": {
      "minimum": 0,
      "title": "Finding Count",
      "type": "integer"
    },
    "evidence_ids": {
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
        "type": "string"
      },
      "maxItems": 256,
      "title": "Evidence Ids",
      "type": "array"
    },
    "source_kind": {
      "const": "published_episode_projection",
      "default": "published_episode_projection",
      "title": "Source Kind",
      "type": "string"
    },
    "limitations": {
      "items": {
        "maxLength": 1000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 32,
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "robot_id",
    "episode_id",
    "revision",
    "task_label",
    "state",
    "outcome",
    "verification",
    "coverage",
    "started_at",
    "event_count",
    "asset_count",
    "finding_count"
  ],
  "title": "EpisodeSummary",
  "type": "object"
}