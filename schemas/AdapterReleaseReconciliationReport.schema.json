{
  "$defs": {
    "AdapterReleaseConsistencyStatus": {
      "enum": [
        "IN_SYNC",
        "TARGET_EMPTY",
        "TARGET_DIVERGED",
        "DESIRED_IS_PREVIOUS",
        "BLOCKED"
      ],
      "title": "AdapterReleaseConsistencyStatus",
      "type": "string"
    },
    "AdapterReleaseDesiredState": {
      "additionalProperties": false,
      "description": "Controller authority projected onto one target deployment.",
      "properties": {
        "schema_version": {
          "const": "rolo-adapter-release-desired-state/v1",
          "default": "rolo-adapter-release-desired-state/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "target_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Target Id",
          "type": "string"
        },
        "robot_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Robot Id",
          "type": "string"
        },
        "release_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Release Id",
          "type": "string"
        },
        "controller_release_index_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Controller Release Index Sha256",
          "type": "string"
        },
        "transfer_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Transfer Manifest Sha256",
          "type": "string"
        },
        "release_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Release Manifest Sha256",
          "type": "string"
        },
        "bundle_manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Bundle Manifest Sha256",
          "type": "string"
        },
        "runtime_context_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Runtime Context Sha256",
          "type": "string"
        }
      },
      "required": [
        "target_id",
        "robot_id",
        "release_id",
        "controller_release_index_sha256",
        "transfer_manifest_sha256",
        "release_manifest_sha256",
        "bundle_manifest_sha256",
        "runtime_context_sha256"
      ],
      "title": "AdapterReleaseDesiredState",
      "type": "object"
    },
    "AdapterReleaseReconciliationAction": {
      "enum": [
        "NONE",
        "DEPLOY_AND_ACTIVATE_DESIRED",
        "ACTIVATE_STAGED_DESIRED",
        "ROLLBACK_TO_DESIRED",
        "MANUAL_REVIEW"
      ],
      "title": "AdapterReleaseReconciliationAction",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Controller-only plan. It never performs the proposed mutation.",
  "properties": {
    "schema_version": {
      "const": "rolo-adapter-release-reconciliation-report/v1",
      "default": "rolo-adapter-release-reconciliation-report/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "desired": {
      "$ref": "#/$defs/AdapterReleaseDesiredState"
    },
    "status": {
      "$ref": "#/$defs/AdapterReleaseConsistencyStatus"
    },
    "action": {
      "$ref": "#/$defs/AdapterReleaseReconciliationAction"
    },
    "requires_reconciliation": {
      "title": "Requires Reconciliation",
      "type": "boolean"
    },
    "requires_approval": {
      "title": "Requires Approval",
      "type": "boolean"
    },
    "target_snapshot_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Snapshot Sha256"
    },
    "expect_current_present": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expect Current Present"
    },
    "expected_current_transfer_manifest_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Current Transfer Manifest Sha256"
    },
    "reason": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    }
  },
  "required": [
    "desired",
    "status",
    "action",
    "requires_reconciliation",
    "requires_approval",
    "reason"
  ],
  "title": "AdapterReleaseReconciliationReport",
  "type": "object"
}