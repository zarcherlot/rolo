{
  "$defs": {
    "ResolutionStatus": {
      "enum": [
        "SUCCEEDED",
        "PARTIAL"
      ],
      "title": "ResolutionStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "robot-software-summary/v1",
      "default": "robot-software-summary/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "discovery_id": {
      "title": "Discovery Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ResolutionStatus"
    },
    "dependency_report_ref": {
      "default": "",
      "title": "Dependency Report Ref",
      "type": "string"
    },
    "direct_dependency_count": {
      "default": 0,
      "minimum": 0,
      "title": "Direct Dependency Count",
      "type": "integer"
    },
    "installed_dependency_count": {
      "default": 0,
      "minimum": 0,
      "title": "Installed Dependency Count",
      "type": "integer"
    },
    "missing_dependency_count": {
      "default": 0,
      "minimum": 0,
      "title": "Missing Dependency Count",
      "type": "integer"
    },
    "conflicting_dependency_count": {
      "default": 0,
      "minimum": 0,
      "title": "Conflicting Dependency Count",
      "type": "integer"
    },
    "unknown_dependency_count": {
      "default": 0,
      "minimum": 0,
      "title": "Unknown Dependency Count",
      "type": "integer"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "discovery_id",
    "status"
  ],
  "title": "SoftwareSummary",
  "type": "object"
}