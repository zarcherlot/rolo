{
  "$defs": {
    "EpisodeObservationBundleSummary": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "rolo-episode-observation-bundle-summary/v1",
          "default": "rolo-episode-observation-bundle-summary/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "robot_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Robot Id",
          "type": "string"
        },
        "episode_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Episode Id",
          "type": "string"
        },
        "episode_revision": {
          "minimum": 1,
          "title": "Episode Revision",
          "type": "integer"
        },
        "bundle_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Bundle Id",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "parent_bundle_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Parent Bundle Id"
        },
        "trigger_kind": {
          "$ref": "#/$defs/ObservationBundleTrigger"
        },
        "status": {
          "$ref": "#/$defs/ObservationBundleStatus"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "window_start_offset_ms": {
          "minimum": 0,
          "title": "Window Start Offset Ms",
          "type": "integer"
        },
        "window_end_offset_ms": {
          "exclusiveMinimum": 0,
          "title": "Window End Offset Ms",
          "type": "integer"
        },
        "synchronization": {
          "$ref": "#/$defs/EpisodeSynchronization"
        },
        "spatial_alignment": {
          "$ref": "#/$defs/ObservationSpatialAlignment"
        },
        "world_scope": {
          "$ref": "#/$defs/ObservationWorldScope"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/EpisodeObservationSourceCoverage"
          },
          "maxItems": 64,
          "title": "Sources",
          "type": "array"
        },
        "asset_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "maxItems": 256,
          "title": "Asset Ids",
          "type": "array"
        },
        "evidence_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "maxItems": 256,
          "title": "Evidence Ids",
          "type": "array"
        },
        "limitations": {
          "items": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "title": "Limitations",
          "type": "array"
        },
        "influences_verification": {
          "const": false,
          "default": false,
          "title": "Influences Verification",
          "type": "boolean"
        }
      },
      "required": [
        "robot_id",
        "episode_id",
        "episode_revision",
        "bundle_id",
        "sequence",
        "trigger_kind",
        "status",
        "created_at",
        "window_start_offset_ms",
        "window_end_offset_ms",
        "synchronization",
        "spatial_alignment",
        "world_scope"
      ],
      "title": "EpisodeObservationBundleSummary",
      "type": "object"
    },
    "EpisodeObservationSourceCoverage": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "rolo-episode-observation-source-coverage/v1",
          "default": "rolo-episode-observation-source-coverage/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "robot_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Robot Id",
          "type": "string"
        },
        "episode_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Episode Id",
          "type": "string"
        },
        "episode_revision": {
          "minimum": 1,
          "title": "Episode Revision",
          "type": "integer"
        },
        "bundle_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Bundle Id",
          "type": "string"
        },
        "source_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Source Id",
          "type": "string"
        },
        "label": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "source_kind": {
          "$ref": "#/$defs/ObservationSourceKind"
        },
        "modality": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Modality",
          "type": "string"
        },
        "world_kind": {
          "$ref": "#/$defs/EpisodeWorldKind"
        },
        "availability": {
          "$ref": "#/$defs/ObservationSourceAvailability"
        },
        "synchronization": {
          "$ref": "#/$defs/EpisodeSynchronization"
        },
        "spatial_alignment": {
          "$ref": "#/$defs/ObservationSpatialAlignment"
        },
        "asset_ids": {
          "items": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
            "type": "string"
          },
          "maxItems": 256,
          "title": "Asset Ids",
          "type": "array"
        },
        "limitations": {
          "items": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "robot_id",
        "episode_id",
        "episode_revision",
        "bundle_id",
        "source_id",
        "label",
        "source_kind",
        "modality",
        "world_kind",
        "availability",
        "synchronization",
        "spatial_alignment"
      ],
      "title": "EpisodeObservationSourceCoverage",
      "type": "object"
    },
    "EpisodeSynchronization": {
      "enum": [
        "SYNCED",
        "DEGRADED",
        "UNSYNCED",
        "UNKNOWN"
      ],
      "title": "EpisodeSynchronization",
      "type": "string"
    },
    "EpisodeWorldKind": {
      "enum": [
        "PHYSICAL",
        "SIMULATED",
        "REPLAYED"
      ],
      "title": "EpisodeWorldKind",
      "type": "string"
    },
    "ObservationBundleStatus": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "UNAVAILABLE"
      ],
      "title": "ObservationBundleStatus",
      "type": "string"
    },
    "ObservationBundleTrigger": {
      "enum": [
        "INITIAL",
        "SUPPLEMENTARY"
      ],
      "title": "ObservationBundleTrigger",
      "type": "string"
    },
    "ObservationSourceAvailability": {
      "enum": [
        "AVAILABLE",
        "MISSING",
        "STALE",
        "REJECTED",
        "UNAVAILABLE"
      ],
      "title": "ObservationSourceAvailability",
      "type": "string"
    },
    "ObservationSourceKind": {
      "enum": [
        "ONBOARD_SENSOR",
        "EXTERNAL_MEASUREMENT",
        "ROBOT_STATE",
        "SPATIAL_MODEL",
        "DETERMINISTIC_RENDER",
        "TRUSTED_GUI_CAPTURE",
        "SIMULATION"
      ],
      "title": "ObservationSourceKind",
      "type": "string"
    },
    "ObservationSpatialAlignment": {
      "enum": [
        "ALIGNED",
        "DEGRADED",
        "UNALIGNED",
        "UNKNOWN"
      ],
      "title": "ObservationSpatialAlignment",
      "type": "string"
    },
    "ObservationWorldScope": {
      "enum": [
        "NONE",
        "PHYSICAL_ONLY",
        "SIMULATED_ONLY",
        "REPLAYED_ONLY",
        "MIXED"
      ],
      "title": "ObservationWorldScope",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "rolo-episode-observation-bundle-collection/v1",
      "default": "rolo-episode-observation-bundle-collection/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "robot_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Robot Id",
      "type": "string"
    },
    "episode_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Episode Id",
      "type": "string"
    },
    "episode_revision": {
      "minimum": 1,
      "title": "Episode Revision",
      "type": "integer"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/EpisodeObservationBundleSummary"
      },
      "title": "Items",
      "type": "array"
    },
    "limit": {
      "maximum": 20,
      "minimum": 1,
      "title": "Limit",
      "type": "integer"
    },
    "cursor": {
      "anyOf": [
        {
          "maxLength": 80,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cursor"
    },
    "next_cursor": {
      "anyOf": [
        {
          "maxLength": 80,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Cursor"
    },
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "immutable": {
      "const": true,
      "default": true,
      "title": "Immutable",
      "type": "boolean"
    },
    "limitations": {
      "items": {
        "maxLength": 1000,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 32,
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "robot_id",
    "episode_id",
    "episode_revision",
    "items",
    "limit",
    "as_of"
  ],
  "title": "EpisodeObservationBundleCollection",
  "type": "object"
}
