{
  "$defs": {
    "TargetExecutionErrorCode": {
      "enum": [
        "CANCELLED",
        "CONFIGURATION_ERROR",
        "CONNECTION_FAILED",
        "CREDENTIAL_UNAVAILABLE",
        "HOST_KEY_VERIFICATION_FAILED",
        "INTEGRITY_ERROR",
        "IO_ERROR",
        "AUTHENTICATION_FAILED",
        "AUTHORIZATION_FAILED",
        "NON_ZERO_EXIT",
        "OUTPUT_LIMIT",
        "OFFSET_MISMATCH",
        "PROTOCOL_ERROR",
        "SPAWN_FAILED",
        "TIMEOUT"
      ],
      "title": "TargetExecutionErrorCode",
      "type": "string"
    },
    "TargetExecutionStatus": {
      "enum": [
        "SUCCEEDED",
        "FAILED"
      ],
      "title": "TargetExecutionStatus",
      "type": "string"
    },
    "TargetExecutorKind": {
      "enum": [
        "LOCAL",
        "SSH"
      ],
      "title": "TargetExecutorKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "rolo-target-inspection-result/v1",
      "default": "rolo-target-inspection-result/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "request_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Request Id",
      "type": "string"
    },
    "request_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Request Sha256",
      "type": "string"
    },
    "executor_kind": {
      "$ref": "#/$defs/TargetExecutorKind"
    },
    "status": {
      "$ref": "#/$defs/TargetExecutionStatus"
    },
    "error_code": {
      "anyOf": [
        {
          "$ref": "#/$defs/TargetExecutionErrorCode"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exit Code"
    },
    "stdout": {
      "maxLength": 2000000,
      "title": "Stdout",
      "type": "string"
    },
    "stderr": {
      "maxLength": 512000,
      "title": "Stderr",
      "type": "string"
    },
    "timed_out": {
      "default": false,
      "title": "Timed Out",
      "type": "boolean"
    },
    "output_limited": {
      "default": false,
      "title": "Output Limited",
      "type": "boolean"
    },
    "cancelled": {
      "default": false,
      "title": "Cancelled",
      "type": "boolean"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "request_sha256",
    "executor_kind",
    "status",
    "stdout",
    "stderr",
    "started_at",
    "finished_at"
  ],
  "title": "TargetInspectionResult",
  "type": "object"
}