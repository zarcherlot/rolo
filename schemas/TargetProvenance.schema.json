{
  "additionalProperties": false,
  "description": "Evidence that an observation was collected from the requested target.",
  "properties": {
    "schema_version": {
      "const": "rolo-target-provenance/v1",
      "default": "rolo-target-provenance/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "target_id": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Target Id",
      "type": "string"
    },
    "source": {
      "maxLength": 256,
      "minLength": 1,
      "title": "Source",
      "type": "string"
    },
    "collector_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Collector Version",
      "type": "string"
    },
    "collected_at": {
      "format": "date-time",
      "title": "Collected At",
      "type": "string"
    },
    "clock_offset_ms": {
      "maximum": 86400000,
      "minimum": -86400000,
      "title": "Clock Offset Ms",
      "type": "number"
    }
  },
  "required": [
    "target_id",
    "source",
    "collector_version",
    "collected_at",
    "clock_offset_ms"
  ],
  "title": "TargetProvenance",
  "type": "object"
}