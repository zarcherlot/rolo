{
  "additionalProperties": false,
  "description": "Strict public request; package bytes are addressed only through the registry.",
  "properties": {
    "schema_version": {
      "const": "rolo-target-bootstrap-job-submission/v1",
      "default": "rolo-target-bootstrap-job-submission/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "package_ref": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}@[0-9a-f]{64}$",
      "title": "Package Ref",
      "type": "string"
    },
    "approver_principal": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
      "title": "Approver Principal",
      "type": "string"
    },
    "approval_ttl_s": {
      "default": 900,
      "maximum": 86400,
      "minimum": 60,
      "title": "Approval Ttl S",
      "type": "integer"
    },
    "expect_current_present": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": false,
      "title": "Expect Current Present"
    },
    "expected_current_manifest_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Current Manifest Sha256"
    },
    "install_authorization_key": {
      "default": true,
      "title": "Install Authorization Key",
      "type": "boolean"
    },
    "expected_authorization_key_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Expected Authorization Key Sha256"
    },
    "timeout_s": {
      "default": 300.0,
      "maximum": 1800.0,
      "minimum": 10.0,
      "title": "Timeout S",
      "type": "number"
    }
  },
  "required": [
    "package_ref",
    "approver_principal"
  ],
  "title": "TargetBootstrapJobSubmission",
  "type": "object"
}