        },
        "allowed_groups": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Groups",
          "type": "array"
        }
      },
      "title": "InvocationRule",
      "type": "object"
    },
    "WriteInvocationRule": {
      "additionalProperties": false,
      "properties": {
        "allowed_users": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Users",
          "type": "array"
        },
        "allowed_groups": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Groups",
          "type": "array"
        },
        "allowed_operations": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Operations",
          "type": "array"
        }
      },
      "title": "WriteInvocationRule",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "rolo-invocation-policy/v1",
