{
  "$defs": {
    "ContentResourceRule": {
      "additionalProperties": false,
      "properties": {
        "operation": {
          "minLength": 1,
          "title": "Operation",
          "type": "string"
        },
        "classification": {
          "const": "SENSITIVE",
          "title": "Classification",
          "type": "string"
        },
        "allowed_roots": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Roots",
          "type": "array"
        },
        "allowed_resources": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Resources",
          "type": "array"
        },
        "max_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 100000000,
          "title": "Max Bytes",
          "type": "integer"
        }
      },
      "required": [
        "operation",
        "classification",
        "max_bytes"
      ],
      "title": "ContentResourceRule",
      "type": "object"
    },
    "InvocationRule": {
      "additionalProperties": false,
      "properties": {
        "allowed_users": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Users",
