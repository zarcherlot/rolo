{
  "$defs": {
    "EpisodeObservation": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "rolo-episode-observation/v1",
          "default": "rolo-episode-observation/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sequence": {
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "phase": {
          "$ref": "#/$defs/EpisodePhase"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        },
        "payload": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "minProperties": 1,
          "title": "Payload",
          "type": "object"
        },
        "provenance": {
          "$ref": "#/$defs/TargetProvenance"
        }
      },
      "required": [
        "sequence",
        "phase",
        "observed_at",
        "payload",
        "provenance"
      ],
      "title": "EpisodeObservation",
      "type": "object"
    },
    "EpisodePhase": {
      "enum": [
        "baseline",
        "observe",
        "hypothesis",
        "change",
        "smoke",
        "decision"
      ],
      "title": "EpisodePhase",
      "type": "string"
    },
    "JsonValue": {},
    "TargetProvenance": {
      "additionalProperties": false,
      "description": "Evidence that an observation was collected from the requested target.",
      "properties": {
        "schema_version": {
          "const": "rolo-target-provenance/v1",
          "default": "rolo-target-provenance/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "target_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        },
        "source": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "collector_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Collector Version",
          "type": "string"
        },
        "collected_at": {
          "format": "date-time",
          "title": "Collected At",
          "type": "string"
        },
        "clock_offset_ms": {
          "maximum": 86400000,
          "minimum": -86400000,
          "title": "Clock Offset Ms",
          "type": "number"
        }
      },
      "required": [
        "target_id",
        "source",
        "collector_version",
        "collected_at",
        "clock_offset_ms"
      ],
      "title": "TargetProvenance",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Append-only, target-bound observation bundle for one Diagnose episode.",
  "properties": {
    "schema_version": {
      "const": "rolo-diagnosis-episode/v1",
      "default": "rolo-diagnosis-episode/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "episode_id": {
      "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
      "title": "Episode Id",
      "type": "string"
    },
    "robot_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Robot Id",
      "type": "string"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "ended_at": {
      "format": "date-time",
      "title": "Ended At",
      "type": "string"
    },
    "observations": {
      "items": {
        "$ref": "#/$defs/EpisodeObservation"
      },
      "maxItems": 2048,
      "minItems": 1,
      "title": "Observations",
      "type": "array"
    },
    "status": {
      "default": "COMPLETE",
      "enum": [
        "COMPLETE",
        "INCOMPLETE"
      ],
      "title": "Status",
      "type": "string"
    }
  },
  "required": [
    "robot_id",
    "started_at",
    "ended_at",
    "observations"
  ],
  "title": "DiagnosisEpisode",
  "type": "object"
}