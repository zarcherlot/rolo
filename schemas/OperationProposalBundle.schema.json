{
  "$defs": {
    "AgentArtifactProvenance": {
      "additionalProperties": false,
      "description": "Bounded, secret-free identity for one Agent-produced artifact.",
      "properties": {
        "skill_name": {
          "maxLength": 64,
          "pattern": "^rolo-[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Skill Name",
          "type": "string"
        },
        "skill_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
          "title": "Skill Version",
          "type": "string"
        },
        "model_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "input_artifact_sha256": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxProperties": 64,
          "title": "Input Artifact Sha256",
          "type": "object"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "skill_name",
        "skill_version",
        "model_id"
      ],
      "title": "AgentArtifactProvenance",
      "type": "object"
    },
    "AgentBudgetUsage": {
      "additionalProperties": false,
      "description": "Auditable resource use and stopping reason for one bounded Agent run.",
      "properties": {
        "rounds": {
          "maximum": 256,
          "minimum": 0,
          "title": "Rounds",
          "type": "integer"
        },
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "elapsed_ms": {
          "minimum": 0,
          "title": "Elapsed Ms",
          "type": "integer"
        },
        "result_bytes": {
          "minimum": 0,
          "title": "Result Bytes",
          "type": "integer"
        },
        "stop_reason": {
          "$ref": "#/$defs/AgentStopReason"
        }
      },
      "required": [
        "rounds",
        "input_tokens",
        "output_tokens",
        "elapsed_ms",
        "result_bytes",
        "stop_reason"
      ],
      "title": "AgentBudgetUsage",
      "type": "object"
    },
    "AgentOperationProposal": {
      "additionalProperties": false,
      "description": "Untrusted mapping proposal that only references collected target evidence.",
      "properties": {
        "operation": {
          "maxLength": 160,
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$",
          "title": "Operation",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Evidence Refs",
          "type": "array"
        },
        "route_resource_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Route Resource Ids",
          "type": "array"
        },
        "executable_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Executable Ids",
          "type": "array"
        },
        "hardware_resource_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "title": "Hardware Resource Ids",
          "type": "array"
        },
        "confidence": {
          "$ref": "#/$defs/ProposalConfidence"
        },
        "rationale": {
          "maxLength": 2000,
          "minLength": 8,
          "title": "Rationale",
          "type": "string"
        },
        "counter_evidence_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "title": "Counter Evidence Refs",
          "type": "array"
        },
        "requested_verification": {
          "items": {
            "$ref": "#/$defs/VerificationRequest"
          },
          "maxItems": 16,
          "title": "Requested Verification",
          "type": "array"
        }
      },
      "required": [
        "operation",
        "evidence_refs",
        "confidence",
        "rationale"
      ],
      "title": "AgentOperationProposal",
      "type": "object"
    },
    "AgentStopReason": {
      "enum": [
        "COMPLETED",
        "BUDGET_EXHAUSTED",
        "NO_MORE_ACTIONS",
        "BLOCKED",
        "PROVIDER_FAILURE"
      ],
      "title": "AgentStopReason",
      "type": "string"
    },
    "ProposalConfidence": {
      "enum": [
        "LOW",
        "MEDIUM"
      ],
      "title": "ProposalConfidence",
      "type": "string"
    },
    "VerificationRequest": {
      "additionalProperties": false,
      "description": "One deterministic follow-up requested by an untrusted mapping Agent.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/VerificationRequestKind"
        },
        "subject_ref": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Subject Ref",
          "type": "string"
        },
        "reason": {
          "maxLength": 1000,
          "minLength": 8,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "subject_ref",
        "reason"
      ],
      "title": "VerificationRequest",
      "type": "object"
    },
    "VerificationRequestKind": {
      "enum": [
        "ROUTE_OBSERVATION",
        "EXECUTABLE_INSPECTION",
        "HARDWARE_INSPECTION",
        "CONTRACT_REVIEW"
      ],
      "title": "VerificationRequestKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Registry-bound Agent proposals awaiting deterministic Rolo validation.",
  "properties": {
    "schema_version": {
      "const": "rolo-operation-proposal-bundle/v1",
      "default": "rolo-operation-proposal-bundle/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "robot_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Robot Id",
      "type": "string"
    },
    "discovery_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Discovery Id",
      "type": "string"
    },
    "target_fingerprint_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Target Fingerprint Sha256",
      "type": "string"
    },
    "registry_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Registry Version",
      "type": "string"
    },
    "registry_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Registry Sha256",
      "type": "string"
    },
    "contract_catalog_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Contract Catalog Sha256",
      "type": "string"
    },
    "registry_operation_count": {
      "maximum": 2048,
      "minimum": 1,
      "title": "Registry Operation Count",
      "type": "integer"
    },
    "proposals": {
      "items": {
        "$ref": "#/$defs/AgentOperationProposal"
      },
      "maxItems": 2048,
      "title": "Proposals",
      "type": "array"
    },
    "unmapped_capabilities": {
      "items": {
        "type": "string"
      },
      "maxItems": 128,
      "title": "Unmapped Capabilities",
      "type": "array"
    },
    "unknowns": {
      "items": {
        "type": "string"
      },
      "maxItems": 128,
      "title": "Unknowns",
      "type": "array"
    },
    "budget_usage": {
      "$ref": "#/$defs/AgentBudgetUsage"
    },
    "provenance": {
      "$ref": "#/$defs/AgentArtifactProvenance"
    }
  },
  "required": [
    "robot_id",
    "discovery_id",
    "target_fingerprint_sha256",
    "registry_version",
    "registry_sha256",
    "contract_catalog_sha256",
    "registry_operation_count",
    "budget_usage",
    "provenance"
  ],
  "title": "OperationProposalBundle",
  "type": "object"
}