{
  "$defs": {
    "AgentRequirement": {
      "enum": [
        "coding_agent",
        "diagnosis_agent",
        "test_agent"
      ],
      "title": "AgentRequirement",
      "type": "string"
    },
    "BuildPlanStatus": {
      "enum": [
        "BLOCKED",
        "REQUIRES_CODING",
        "READY_FOR_CONFORMANCE"
      ],
      "title": "BuildPlanStatus",
      "type": "string"
    },
    "BuildTask": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "operations": {
          "items": {
            "type": "string"
          },
          "title": "Operations",
          "type": "array"
        },
        "required_skill": {
          "title": "Required Skill",
          "type": "string"
        },
        "agent_requirement": {
          "$ref": "#/$defs/AgentRequirement",
          "default": "coding_agent"
        }
      },
      "required": [
        "id",
        "description",
        "required_skill"
      ],
      "title": "BuildTask",
      "type": "object"
    },
    "CodingAgentConfig": {
      "description": "Secret-free provider selection persisted with a Stage 1 build plan.",
      "properties": {
        "provider": {
          "default": "codex",
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "executor": {
          "default": "codex",
          "minLength": 1,
          "title": "Executor",
          "type": "string"
        },
        "base_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base Url"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        },
        "api_key_env": {
          "default": "CODING_AGENT_API_KEY",
          "title": "Api Key Env",
          "type": "string"
        },
        "api_key_configured": {
          "default": false,
          "title": "Api Key Configured",
          "type": "boolean"
        },
        "auto_install": {
          "default": true,
          "title": "Auto Install",
          "type": "boolean"
        },
        "require_auth": {
          "default": true,
          "title": "Require Auth",
          "type": "boolean"
        }
      },
      "title": "CodingAgentConfig",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "robot-build-plan/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "stage": {
      "default": "build",
      "title": "Stage",
      "type": "string"
    },
    "robot_id": {
      "title": "Robot Id",
      "type": "string"
    },
    "source_discovery_id": {
      "title": "Source Discovery Id",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/BuildPlanStatus"
    },
    "tasks": {
      "items": {
        "$ref": "#/$defs/BuildTask"
      },
      "title": "Tasks",
      "type": "array"
    },
    "required_skills": {
      "items": {
        "type": "string"
      },
      "title": "Required Skills",
      "type": "array"
    },
    "coding_agent": {
      "$ref": "#/$defs/CodingAgentConfig"
    },
    "candidate_operations": {
      "items": {
        "type": "string"
      },
      "title": "Candidate Operations",
      "type": "array"
    },
    "state_graph_baseline_required": {
      "default": true,
      "title": "State Graph Baseline Required",
      "type": "boolean"
    },
    "handoff_ref": {
      "title": "Handoff Ref",
      "type": "string"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "robot_id",
    "source_discovery_id",
    "status",
    "tasks",
    "required_skills",
    "handoff_ref"
  ],
  "title": "BuildPlan",
  "type": "object"
}