{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentNativeToolResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tool_id", "status", "argv", "observed_at", "duration_ms", "stdout", "stderr", "stdout_sha256", "stderr_sha256", "truncated", "evidence_kind", "sensitive", "limitations", "evidence_refs"],
  "properties": {
    "schema_version": {"const": "rolo-agent-native-tool-result/v1"},
    "tool_id": {"type": "string"},
    "status": {"enum": ["SUCCEEDED", "UNAVAILABLE", "TIMEOUT", "FAILED", "REJECTED"]},
    "argv": {"type": "array", "items": {"type": "string"}},
    "observed_at": {"type": "string", "format": "date-time"},
    "duration_ms": {"type": "number", "minimum": 0},
    "stdout": {"type": "string"},
    "stderr": {"type": "string"},
    "stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "truncated": {"type": "boolean"},
    "evidence_kind": {"type": "string"},
    "sensitive": {"type": "boolean"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}}
  }
}
