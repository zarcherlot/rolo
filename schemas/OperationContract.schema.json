{
  "$defs": {
    "ContractLifecycle": {
      "enum": [
        "DRAFT",
        "GATEABLE",
        "RELEASED",
        "DEPRECATED"
      ],
      "title": "ContractLifecycle",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Product-owned semantics for one canonical operation.",
  "properties": {
    "schema_version": {
      "const": "robot-operation-contract/v1",
      "default": "robot-operation-contract/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "contract_id": {
      "title": "Contract Id",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    },
    "lifecycle": {
      "$ref": "#/$defs/ContractLifecycle"
    },
    "operation": {
      "title": "Operation",
      "type": "string"
    },
    "layer": {
      "enum": [
        "control",
        "hw",
        "linux",
        "middleware",
        "ros",
        "app"
      ],
      "title": "Layer",
      "type": "string"
    },
    "description": {
      "minLength": 8,
      "title": "Description",
      "type": "string"
    },
    "risk": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3"
      ],
      "title": "Risk",
      "type": "string"
    },
    "access": {
      "enum": [
        "read",
        "write"
      ],
      "title": "Access",
      "type": "string"
    },
    "idempotent": {
      "title": "Idempotent",
      "type": "boolean"
    },
    "cancelable": {
      "title": "Cancelable",
      "type": "boolean"
    },
    "max_duration_s": {
      "exclusiveMinimum": 0,
      "title": "Max Duration S",
      "type": "number"
    },
    "canonical_cli": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Canonical Cli",
      "type": "array"
    },
    "input_schema": {
      "additionalProperties": true,
      "title": "Input Schema",
      "type": "object"
    },
    "output_schema": {
      "additionalProperties": true,
      "title": "Output Schema",
      "type": "object"
    },
    "error_codes": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "title": "Error Codes",
      "type": "array"
    },
    "capability_requirements": {
      "items": {
        "type": "string"
      },
      "title": "Capability Requirements",
      "type": "array"
    },
    "preconditions": {
      "items": {
        "type": "string"
      },
      "title": "Preconditions",
      "type": "array"
    },
    "postconditions": {
      "items": {
        "type": "string"
      },
      "title": "Postconditions",
      "type": "array"
    },
    "semantic_units": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Semantic Units",
      "type": "object"
    },
    "coordinate_frames": {
      "items": {
        "type": "string"
      },
      "title": "Coordinate Frames",
      "type": "array"
    },
    "time_semantics": {
      "default": "response observed_at uses UTC",
      "title": "Time Semantics",
      "type": "string"
    },
    "side_effects": {
      "items": {
        "type": "string"
      },
      "title": "Side Effects",
      "type": "array"
    },
    "resource_locks": {
      "items": {
        "type": "string"
      },
      "title": "Resource Locks",
      "type": "array"
    },
    "rate_limit": {
      "default": "on_demand",
      "title": "Rate Limit",
      "type": "string"
    },
    "retry_policy": {
      "default": "none",
      "title": "Retry Policy",
      "type": "string"
    },
    "compensation_operation": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Compensation Operation"
    }
  },
  "required": [
    "contract_id",
    "version",
    "lifecycle",
    "operation",
    "layer",
    "description",
    "risk",
    "access",
    "idempotent",
    "cancelable",
    "max_duration_s",
    "canonical_cli",
    "input_schema",
    "output_schema",
    "error_codes"
  ],
  "title": "OperationContract",
  "type": "object"
}