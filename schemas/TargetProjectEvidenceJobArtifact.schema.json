{
  "$defs": {
    "TargetExecutionErrorCode": {
      "enum": [
        "CANCELLED",
        "CONFIGURATION_ERROR",
        "CONNECTION_FAILED",
        "CREDENTIAL_UNAVAILABLE",
        "HOST_KEY_VERIFICATION_FAILED",
        "INTEGRITY_ERROR",
        "IO_ERROR",
        "AUTHENTICATION_FAILED",
        "AUTHORIZATION_FAILED",
        "NON_ZERO_EXIT",
        "OUTPUT_LIMIT",
        "OFFSET_MISMATCH",
        "PROTOCOL_ERROR",
        "SPAWN_FAILED",
        "TIMEOUT"
      ],
      "title": "TargetExecutionErrorCode",
      "type": "string"
    },
    "TargetExecutionStatus": {
      "enum": [
        "SUCCEEDED",
        "FAILED"
      ],
      "title": "TargetExecutionStatus",
      "type": "string"
    },
    "TargetExecutorKind": {
      "enum": [
        "LOCAL",
        "SSH"
      ],
      "title": "TargetExecutorKind",
      "type": "string"
    },
    "TargetProjectEvidenceExecutionResult": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "rolo-target-project-evidence-execution-result/v1",
          "default": "rolo-target-project-evidence-execution-result/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "request_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Request Id",
          "type": "string"
        },
        "request_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Sha256",
          "type": "string"
        },
        "target_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Target Id",
          "type": "string"
        },
        "robot_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Robot Id",
          "type": "string"
        },
        "workspace_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Workspace Id",
          "type": "string"
        },
        "executor_kind": {
          "$ref": "#/$defs/TargetExecutorKind"
        },
        "execution_status": {
          "$ref": "#/$defs/TargetExecutionStatus"
        },
        "error_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetExecutionErrorCode"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "snapshot": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetProjectEvidenceSnapshot"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "request_id",
        "request_sha256",
        "target_id",
        "robot_id",
        "workspace_id",
        "executor_kind",
        "execution_status"
      ],
      "title": "TargetProjectEvidenceExecutionResult",
      "type": "object"
    },
    "TargetProjectEvidenceHit": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/TargetProjectEvidenceKind"
        },
        "role": {
          "enum": [
            "SOURCE",
            "ARTIFACT",
            "RUNTIME"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "path",
        "kind",
        "role"
      ],
      "title": "TargetProjectEvidenceHit",
      "type": "object"
    },
    "TargetProjectEvidenceJobArtifactStatus": {
      "enum": [
        "SUCCEEDED",
        "FAILED"
      ],
      "title": "TargetProjectEvidenceJobArtifactStatus",
      "type": "string"
    },
    "TargetProjectEvidenceJobFailureCode": {
      "enum": [
        "TARGET_REGISTRATION_CHANGED",
        "EXECUTION_FAILED",
        "RUNNER_ERROR"
      ],
      "title": "TargetProjectEvidenceJobFailureCode",
      "type": "string"
    },
    "TargetProjectEvidenceKind": {
      "enum": [
        "BUILD_METADATA",
        "RUNTIME_METADATA",
        "SOURCE_ENTRYPOINT",
        "ROS_METADATA",
        "DOCUMENTATION"
      ],
      "title": "TargetProjectEvidenceKind",
      "type": "string"
    },
    "TargetProjectEvidenceSnapshot": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "rolo-target-project-evidence-snapshot/v1",
          "default": "rolo-target-project-evidence-snapshot/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "request_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Request Id",
          "type": "string"
        },
        "request_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Request Sha256",
          "type": "string"
        },
        "target_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Target Id",
          "type": "string"
        },
        "robot_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Robot Id",
          "type": "string"
        },
        "workspace_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Workspace Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/TargetProjectEvidenceStatus"
        },
        "hits": {
          "items": {
            "$ref": "#/$defs/TargetProjectEvidenceHit"
          },
          "maxItems": 256,
          "title": "Hits",
          "type": "array"
        },
        "manifest": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetWorkspaceManifest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "request_sha256",
        "target_id",
        "robot_id",
        "workspace_id",
        "status",
        "observed_at"
      ],
      "title": "TargetProjectEvidenceSnapshot",
      "type": "object"
    },
    "TargetProjectEvidenceStatus": {
      "enum": [
        "OBSERVED",
        "NO_EVIDENCE"
      ],
      "title": "TargetProjectEvidenceStatus",
      "type": "string"
    },
    "TargetWorkspaceFile": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Path",
          "type": "string"
        },
        "size_bytes": {
          "maximum": 67108864,
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "executable": {
          "default": false,
          "title": "Executable",
          "type": "boolean"
        },
        "role": {
          "default": "SOURCE",
          "enum": [
            "SOURCE",
            "ARTIFACT",
            "RUNTIME"
          ],
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "path",
        "size_bytes",
        "sha256"
      ],
      "title": "TargetWorkspaceFile",
      "type": "object"
    },
    "TargetWorkspaceManifest": {
      "additionalProperties": false,
      "description": "Bounded target-observed file set; timestamps are excluded from its digest.",
      "properties": {
        "schema_version": {
          "const": "rolo-target-workspace-manifest/v1",
          "default": "rolo-target-workspace-manifest/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "workspace": {
          "$ref": "#/$defs/TargetWorkspaceRef"
        },
        "files": {
          "items": {
            "$ref": "#/$defs/TargetWorkspaceFile"
          },
          "maxItems": 4096,
          "minItems": 1,
          "title": "Files",
          "type": "array"
        },
        "total_size_bytes": {
          "maximum": 536870912,
          "minimum": 0,
          "title": "Total Size Bytes",
          "type": "integer"
        },
        "content_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Content Sha256",
          "type": "string"
        },
        "observed_at": {
          "format": "date-time",
          "title": "Observed At",
          "type": "string"
        }
      },
      "required": [
        "workspace",
        "files",
        "total_size_bytes",
        "content_sha256",
        "observed_at"
      ],
      "title": "TargetWorkspaceManifest",
      "type": "object"
    },
    "TargetWorkspaceRef": {
      "additionalProperties": false,
      "description": "A controller-safe reference to a workspace that exists on one target.",
      "properties": {
        "schema_version": {
          "const": "rolo-target-workspace-ref/v1",
          "default": "rolo-target-workspace-ref/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "workspace_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Workspace Id",
          "type": "string"
        },
        "target_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Target Id",
          "type": "string"
        },
        "robot_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
          "title": "Robot Id",
          "type": "string"
        },
        "root": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Root",
          "type": "string"
        }
      },
      "required": [
        "workspace_id",
        "target_id",
        "robot_id",
        "root"
      ],
      "title": "TargetWorkspaceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "rolo-target-project-evidence-job-artifact/v1",
      "default": "rolo-target-project-evidence-job-artifact/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "job_id": {
      "pattern": "^deployment-[0-9a-f]{32}$",
      "title": "Job Id",
      "type": "string"
    },
    "command_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Command Sha256",
      "type": "string"
    },
    "spec_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Spec Sha256",
      "type": "string"
    },
    "target_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Target Id",
      "type": "string"
    },
    "target_registration_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Target Registration Sha256",
      "type": "string"
    },
    "observed_target_registration_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Observed Target Registration Sha256"
    },
    "status": {
      "$ref": "#/$defs/TargetProjectEvidenceJobArtifactStatus"
    },
    "failure_code": {
      "anyOf": [
        {
          "$ref": "#/$defs/TargetProjectEvidenceJobFailureCode"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "execution": {
      "anyOf": [
        {
          "$ref": "#/$defs/TargetProjectEvidenceExecutionResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "completed_at": {
      "format": "date-time",
      "title": "Completed At",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "command_sha256",
    "spec_sha256",
    "target_id",
    "target_registration_sha256",
    "status",
    "completed_at"
  ],
  "title": "TargetProjectEvidenceJobArtifact",
  "type": "object"
}