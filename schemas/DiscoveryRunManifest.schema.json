{
  "$defs": {
    "DiscoveryProducer": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "rolo",
          "default": "rolo",
          "title": "Name",
          "type": "string"
        },
        "version": {
          "title": "Version",
          "type": "string"
        },
        "build_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Build Revision"
        }
      },
      "required": [
        "version"
      ],
      "title": "DiscoveryProducer",
      "type": "object"
    },
    "ManifestEntry": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        }
      },
      "required": [
        "path",
        "sha256",
        "size_bytes"
      ],
      "title": "ManifestEntry",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "robot-discovery-run-manifest/v1",
      "default": "robot-discovery-run-manifest/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "robot_id": {
      "title": "Robot Id",
      "type": "string"
    },
    "discovery_id": {
      "title": "Discovery Id",
      "type": "string"
    },
    "producer": {
      "$ref": "#/$defs/DiscoveryProducer"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/ManifestEntry"
      },
      "minItems": 1,
      "title": "Files",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "robot_id",
    "discovery_id",
    "files"
  ],
  "title": "DiscoveryRunManifest",
  "type": "object"
}
