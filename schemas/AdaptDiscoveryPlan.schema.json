{
  "$defs": {
    "AgentArtifactProvenance": {
      "additionalProperties": false,
      "description": "Bounded, secret-free identity for one Agent-produced artifact.",
      "properties": {
        "skill_name": {
          "maxLength": 64,
          "pattern": "^rolo-[a-z0-9]+(?:-[a-z0-9]+)*$",
          "title": "Skill Name",
          "type": "string"
        },
        "skill_version": {
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
          "title": "Skill Version",
          "type": "string"
        },
        "model_id": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "input_artifact_sha256": {
          "additionalProperties": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "maxProperties": 64,
          "title": "Input Artifact Sha256",
          "type": "object"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        }
      },
      "required": [
        "skill_name",
        "skill_version",
        "model_id"
      ],
      "title": "AgentArtifactProvenance",
      "type": "object"
    },
    "AgentBudgetUsage": {
      "additionalProperties": false,
      "description": "Auditable resource use and stopping reason for one bounded Agent run.",
      "properties": {
        "rounds": {
          "maximum": 256,
          "minimum": 0,
          "title": "Rounds",
          "type": "integer"
        },
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        },
        "elapsed_ms": {
          "minimum": 0,
          "title": "Elapsed Ms",
          "type": "integer"
        },
        "result_bytes": {
          "minimum": 0,
          "title": "Result Bytes",
          "type": "integer"
        },
        "stop_reason": {
          "$ref": "#/$defs/AgentStopReason"
        }
      },
      "required": [
        "rounds",
        "input_tokens",
        "output_tokens",
        "elapsed_ms",
        "result_bytes",
        "stop_reason"
      ],
      "title": "AgentBudgetUsage",
      "type": "object"
    },
    "AgentStopReason": {
      "enum": [
        "COMPLETED",
        "BUDGET_EXHAUSTED",
        "NO_MORE_ACTIONS",
        "BLOCKED",
        "PROVIDER_FAILURE"
      ],
      "title": "AgentStopReason",
      "type": "string"
    },
    "DiscoveryPlanAction": {
      "additionalProperties": false,
      "description": "One proposed invocation of an orchestrator-owned, read-only definition.",
      "properties": {
        "action_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Action Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "PROBE",
            "QUERY"
          ],
          "title": "Kind",
          "type": "string"
        },
        "definition_id": {
          "pattern": "^[a-z][a-z0-9_.-]{0,127}$",
          "title": "Definition Id",
          "type": "string"
        },
        "parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "maxProperties": 32,
          "title": "Parameters",
          "type": "object"
        },
        "expected_evidence_types": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Expected Evidence Types",
          "type": "array"
        },
        "rationale": {
          "maxLength": 1000,
          "minLength": 8,
          "title": "Rationale",
          "type": "string"
        },
        "risk": {
          "const": "R0",
          "default": "R0",
          "title": "Risk",
          "type": "string"
        }
      },
      "required": [
        "action_id",
        "kind",
        "definition_id",
        "expected_evidence_types",
        "rationale"
      ],
      "title": "DiscoveryPlanAction",
      "type": "object"
    },
    "DiscoveryRemainingBudget": {
      "additionalProperties": false,
      "description": "Budget left for the orchestrator after accepting this proposal.",
      "properties": {
        "rounds": {
          "maximum": 256,
          "minimum": 0,
          "title": "Rounds",
          "type": "integer"
        },
        "elapsed_ms": {
          "minimum": 0,
          "title": "Elapsed Ms",
          "type": "integer"
        },
        "result_bytes": {
          "minimum": 0,
          "title": "Result Bytes",
          "type": "integer"
        },
        "failures": {
          "maximum": 256,
          "minimum": 0,
          "title": "Failures",
          "type": "integer"
        }
      },
      "required": [
        "rounds",
        "elapsed_ms",
        "result_bytes",
        "failures"
      ],
      "title": "DiscoveryRemainingBudget",
      "type": "object"
    },
    "JsonValue": {}
  },
  "additionalProperties": false,
  "description": "A bounded plan proposal; it is never authority to execute a probe.",
  "properties": {
    "schema_version": {
      "const": "rolo-adapt-discovery-plan/v1",
      "default": "rolo-adapt-discovery-plan/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "robot_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Robot Id",
      "type": "string"
    },
    "discovery_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Discovery Id",
      "type": "string"
    },
    "target_fingerprint_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Target Fingerprint Sha256",
      "type": "string"
    },
    "actions": {
      "items": {
        "$ref": "#/$defs/DiscoveryPlanAction"
      },
      "maxItems": 32,
      "title": "Actions",
      "type": "array"
    },
    "unknowns": {
      "items": {
        "type": "string"
      },
      "maxItems": 128,
      "title": "Unknowns",
      "type": "array"
    },
    "stop_conditions": {
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Stop Conditions",
      "type": "array"
    },
    "remaining_budget": {
      "$ref": "#/$defs/DiscoveryRemainingBudget"
    },
    "budget_usage": {
      "$ref": "#/$defs/AgentBudgetUsage"
    },
    "provenance": {
      "$ref": "#/$defs/AgentArtifactProvenance"
    }
  },
  "required": [
    "robot_id",
    "discovery_id",
    "target_fingerprint_sha256",
    "stop_conditions",
    "remaining_budget",
    "budget_usage",
    "provenance"
  ],
  "title": "AdaptDiscoveryPlan",
  "type": "object"
}