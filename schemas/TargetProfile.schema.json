{
  "$defs": {
    "OrchestratorPlacement": {
      "enum": [
        "TARGET_LOCAL",
        "CONTROLLER"
      ],
      "title": "OrchestratorPlacement",
      "type": "string"
    },
    "TargetTransport": {
      "enum": [
        "LOCAL",
        "SSH"
      ],
      "title": "TargetTransport",
      "type": "string"
    },
    "TargetTrustLevel": {
      "enum": [
        "STRICT",
        "CONFIRMED",
        "TOFU_DEV"
      ],
      "title": "TargetTrustLevel",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "rolo-target-profile/v1",
      "default": "rolo-target-profile/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "target_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
      "title": "Target Id",
      "type": "string"
    },
    "orchestrator_placement": {
      "$ref": "#/$defs/OrchestratorPlacement"
    },
    "transport": {
      "$ref": "#/$defs/TargetTransport"
    },
    "connection_profile_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Connection Profile Id"
    },
    "workspace_root": {
      "maxLength": 4096,
      "minLength": 1,
      "title": "Workspace Root",
      "type": "string"
    },
    "desired_rolo_version": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$",
      "title": "Desired Rolo Version",
      "type": "string"
    },
    "trust_level": {
      "$ref": "#/$defs/TargetTrustLevel",
      "default": "STRICT"
    },
    "release_signing_key_id": {
      "anyOf": [
        {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Release Signing Key Id"
    },
    "release_signing_public_key_path": {
      "anyOf": [
        {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Release Signing Public Key Path"
    },
    "release_signing_public_key_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Release Signing Public Key Sha256"
    }
  },
  "required": [
    "target_id",
    "orchestrator_placement",
    "transport",
    "workspace_root",
    "desired_rolo_version"
  ],
  "title": "TargetProfile",
  "type": "object"
}