{
  "$defs": {
    "ApprovalStatus": {
      "enum": [
        "PENDING",
        "APPROVED",
        "REJECTED",
        "EXPIRED"
      ],
      "title": "ApprovalStatus",
      "type": "string"
    },
    "DeploymentJobState": {
      "enum": [
        "CREATED",
        "CONNECTING",
        "HOST_KEY_APPROVAL_REQUIRED",
        "PREFLIGHT",
        "BOOTSTRAPPING",
        "ROLLING_BACK",
        "ENROLLING",
        "COLLECTING_EVIDENCE",
        "DISCOVERING",
        "ADAPTING",
        "GATING",
        "COMPLETE",
        "BLOCKED",
        "FAILED",
        "CANCELLED"
      ],
      "title": "DeploymentJobState",
      "type": "string"
    },
    "SessionAgentAction": {
      "description": "Commands available to the model. Approval decisions are deliberately absent.",
      "enum": [
        "LIST_TARGETS",
        "SHOW_TARGET",
        "ASSESS_CONNECTION",
        "SUBMIT_BOOTSTRAP",
        "SUBMIT_RUNTIME_ROLLBACK",
        "SUBMIT_PROJECT_EVIDENCE",
        "SUBMIT_SOURCE_DISCOVERY",
        "SUBMIT_RUNTIME_EVIDENCE",
        "SUBMIT_ADAPT",
        "GET_JOB",
        "RUN_JOB",
        "CANCEL_JOB",
        "SHOW_APPROVAL",
        "LIST_BLOCKERS"
      ],
      "title": "SessionAgentAction",
      "type": "string"
    },
    "SessionAgentCommandReceipt": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "rolo-session-agent-command-receipt/v1",
          "default": "rolo-session-agent-command-receipt/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "sequence": {
          "maximum": 8,
          "minimum": 1,
          "title": "Sequence",
          "type": "integer"
        },
        "action": {
          "$ref": "#/$defs/SessionAgentAction"
        },
        "command_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Command Sha256",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/SessionAgentTurnStatus"
        },
        "summary": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "target_id": {
          "anyOf": [
            {
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Id"
        },
        "job_id": {
          "anyOf": [
            {
              "pattern": "^deployment-[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Id"
        },
        "approval_id": {
          "anyOf": [
            {
              "pattern": "^approval-[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approval Id"
        },
        "deployment_command_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deployment Command Sha256"
        },
        "job_state": {
          "anyOf": [
            {
              "$ref": "#/$defs/DeploymentJobState"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "approval_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/ApprovalStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "canonical_cli": {
          "anyOf": [
            {
              "maxLength": 8192,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Cli"
        },
        "projection": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetDeploymentTuiSnapshot"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "sequence",
        "action",
        "command_sha256",
        "status",
        "summary"
      ],
      "title": "SessionAgentCommandReceipt",
      "type": "object"
    },
    "SessionAgentTurnStatus": {
      "enum": [
        "COMPLETED",
        "SUBMITTED",
        "APPROVAL_REQUIRED",
        "CANCEL_REQUESTED",
        "BLOCKED",
        "FAILED"
      ],
      "title": "SessionAgentTurnStatus",
      "type": "string"
    },
    "TargetDeploymentTuiField": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
          "title": "Name",
          "type": "string"
        },
        "value": {
          "maxLength": 4096,
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "title": "TargetDeploymentTuiField",
      "type": "object"
    },
    "TargetDeploymentTuiPage": {
      "enum": [
        "fleet",
        "target",
        "job",
        "approval",
        "blocker"
      ],
      "title": "TargetDeploymentTuiPage",
      "type": "string"
    },
    "TargetDeploymentTuiRow": {
      "additionalProperties": false,
      "properties": {
        "identity": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Identity",
          "type": "string"
        },
        "kind": {
          "enum": [
            "TARGET",
            "JOB",
            "APPROVAL",
            "BLOCKER"
          ],
          "title": "Kind",
          "type": "string"
        },
        "status": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Status",
          "type": "string"
        },
        "summary": {
          "maxLength": 1000,
          "title": "Summary",
          "type": "string"
        },
        "canonical_cli": {
          "anyOf": [
            {
              "maxLength": 8192,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Canonical Cli"
        },
        "fields": {
          "items": {
            "$ref": "#/$defs/TargetDeploymentTuiField"
          },
          "maxItems": 64,
          "title": "Fields",
          "type": "array"
        }
      },
      "required": [
        "identity",
        "kind",
        "status",
        "summary"
      ],
      "title": "TargetDeploymentTuiRow",
      "type": "object"
    },
    "TargetDeploymentTuiSnapshot": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "rolo-target-deployment-tui-snapshot/v1",
          "default": "rolo-target-deployment-tui-snapshot/v1",
          "title": "Schema Version",
          "type": "string"
        },
        "page": {
          "$ref": "#/$defs/TargetDeploymentTuiPage"
        },
        "title": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "captured_at": {
          "format": "date-time",
          "title": "Captured At",
          "type": "string"
        },
        "rows": {
          "items": {
            "$ref": "#/$defs/TargetDeploymentTuiRow"
          },
          "maxItems": 10000,
          "title": "Rows",
          "type": "array"
        }
      },
      "required": [
        "page",
        "title",
        "captured_at"
      ],
      "title": "TargetDeploymentTuiSnapshot",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "rolo-session-agent-session/v1",
      "default": "rolo-session-agent-session/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "pattern": "^agent-session-[0-9a-f]{32}$",
      "title": "Session Id",
      "type": "string"
    },
    "open_request_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Open Request Sha256",
      "type": "string"
    },
    "open_idempotency_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Open Idempotency Sha256",
      "type": "string"
    },
    "principal": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@/-]{0,127}$",
      "title": "Principal",
      "type": "string"
    },
    "permissions": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "title": "Permissions",
      "type": "array"
    },
    "allowed_target_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 1000,
      "minItems": 1,
      "title": "Allowed Target Ids",
      "type": "array"
    },
    "catalog_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Catalog Sha256",
      "type": "string"
    },
    "max_tool_calls": {
      "maximum": 8,
      "minimum": 1,
      "title": "Max Tool Calls",
      "type": "integer"
    },
    "next_sequence": {
      "default": 1,
      "maximum": 9,
      "minimum": 1,
      "title": "Next Sequence",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    },
    "cancelled_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Cancelled At"
    },
    "receipts": {
      "items": {
        "$ref": "#/$defs/SessionAgentCommandReceipt"
      },
      "maxItems": 8,
      "title": "Receipts",
      "type": "array"
    }
  },
  "required": [
    "session_id",
    "open_request_sha256",
    "open_idempotency_sha256",
    "principal",
    "allowed_target_ids",
    "catalog_sha256",
    "max_tool_calls",
    "created_at",
    "expires_at"
  ],
  "title": "SessionAgentSessionRecord",
  "type": "object"
}