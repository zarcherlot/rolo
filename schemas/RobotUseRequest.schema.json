{
  "$defs": {
    "ImageFrame": {
      "properties": {
        "timestamp": {
          "format": "date-time",
          "title": "Timestamp",
          "type": "string"
        },
        "image_url": {
          "anyOf": [
            {
              "maxLength": 8388608,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Image Url"
        },
        "artifact_ref": {
          "anyOf": [
            {
              "maxLength": 512,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artifact Ref"
        },
        "camera_id": {
          "default": "semantic://sensor/front_camera",
          "maxLength": 256,
          "title": "Camera Id",
          "type": "string"
        }
      },
      "required": [
        "timestamp"
      ],
      "title": "ImageFrame",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "robot-use-request/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "request_id": {
      "maxLength": 128,
      "title": "Request Id",
      "type": "string"
    },
    "robot_id": {
      "maxLength": 128,
      "title": "Robot Id",
      "type": "string"
    },
    "execution_id": {
      "maxLength": 128,
      "title": "Execution Id",
      "type": "string"
    },
    "test_case_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Test Case Id"
    },
    "window_start": {
      "format": "date-time",
      "title": "Window Start",
      "type": "string"
    },
    "window_end": {
      "format": "date-time",
      "title": "Window End",
      "type": "string"
    },
    "frames": {
      "items": {
        "$ref": "#/$defs/ImageFrame"
      },
      "maxItems": 16,
      "minItems": 1,
      "title": "Frames",
      "type": "array"
    },
    "task_contract": {
      "additionalProperties": true,
      "title": "Task Contract",
      "type": "object"
    },
    "telemetry_summary": {
      "additionalProperties": true,
      "title": "Telemetry Summary",
      "type": "object"
    }
  },
  "required": [
    "request_id",
    "robot_id",
    "execution_id",
    "window_start",
    "window_end",
    "frames",
    "task_contract"
  ],
  "title": "RobotUseRequest",
  "type": "object"
}