{
  "$defs": {
    "NativeToolSessionBudget": {
      "additionalProperties": false,
      "properties": {
        "max_calls": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Max Calls",
          "type": "integer"
        },
        "max_elapsed_s": {
          "exclusiveMinimum": 0,
          "maximum": 86400,
          "title": "Max Elapsed S",
          "type": "number"
        },
        "max_result_bytes": {
          "maximum": 1000000000,
          "minimum": 1,
          "title": "Max Result Bytes",
          "type": "integer"
        }
      },
      "required": [
        "max_calls",
        "max_elapsed_s",
        "max_result_bytes"
      ],
      "title": "NativeToolSessionBudget",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Immutable authority for one Agent-native tool session.",
  "properties": {
    "schema_version": {
      "const": "rolo-native-tool-session/v1",
      "default": "rolo-native-tool-session/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Session Id",
      "type": "string"
    },
    "nonce": {
      "pattern": "^[A-Za-z0-9_-]{16,128}$",
      "title": "Nonce",
      "type": "string"
    },
    "robot_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Robot Id",
      "type": "string"
    },
    "stage": {
      "enum": [
        "adapt",
        "diagnose",
        "verify"
      ],
      "title": "Stage",
      "type": "string"
    },
    "native_catalog_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Native Catalog Sha256",
      "type": "string"
    },
    "allowed_tools": {
      "items": {
        "type": "string"
      },
      "maxItems": 256,
      "minItems": 1,
      "title": "Allowed Tools",
      "type": "array"
    },
    "policy_version": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Policy Version",
      "type": "string"
    },
    "budget": {
      "$ref": "#/$defs/NativeToolSessionBudget"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "expires_at": {
      "format": "date-time",
      "title": "Expires At",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "nonce",
    "robot_id",
    "stage",
    "native_catalog_sha256",
    "allowed_tools",
    "policy_version",
    "budget",
    "created_at",
    "expires_at"
  ],
  "title": "NativeToolSessionDescriptor",
  "type": "object"
}