{
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "rolo-deployment-authorization-key-pin/v1",
      "default": "rolo-deployment-authorization-key-pin/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "target_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Target Id",
      "type": "string"
    },
    "key_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$",
      "title": "Key Id",
      "type": "string"
    },
    "public_key_base64": {
      "maxLength": 32768,
      "title": "Public Key Base64",
      "type": "string"
    },
    "public_key_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Public Key Sha256",
      "type": "string"
    },
    "installed_by_approval_id": {
      "pattern": "^approval-[0-9a-f]{32}$",
      "title": "Installed By Approval Id",
      "type": "string"
    },
    "installed_at": {
      "format": "date-time",
      "title": "Installed At",
      "type": "string"
    }
  },
  "required": [
    "target_id",
    "key_id",
    "public_key_base64",
    "public_key_sha256",
    "installed_by_approval_id",
    "installed_at"
  ],
  "title": "DeploymentAuthorizationKeyPin",
  "type": "object"
}