{
  "$defs": {
    "CandidateResolutionStatus": {
      "enum": [
        "INSTALLED",
        "MISSING",
        "VERSION_CONFLICT",
        "UNMANAGED",
        "UNKNOWN",
        "NOT_APPLICABLE",
        "BLOCKED_BY_POLICY"
      ],
      "title": "CandidateResolutionStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidate_id": {
      "title": "Candidate Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "ecosystem": {
      "enum": [
        "python",
        "ros",
        "dpkg",
        "executable"
      ],
      "title": "Ecosystem",
      "type": "string"
    },
    "relevance": {
      "const": "DIRECT",
      "default": "DIRECT",
      "title": "Relevance",
      "type": "string"
    },
    "required": {
      "default": true,
      "title": "Required",
      "type": "boolean"
    },
    "specifiers": {
      "items": {
        "type": "string"
      },
      "title": "Specifiers",
      "type": "array"
    },
    "scopes": {
      "items": {
        "type": "string"
      },
      "title": "Scopes",
      "type": "array"
    },
    "evidence_refs": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "executable_ids": {
      "items": {
        "type": "string"
      },
      "title": "Executable Ids",
      "type": "array"
    },
    "status": {
      "$ref": "#/$defs/CandidateResolutionStatus",
      "default": "UNKNOWN"
    },
    "resolved_package_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resolved Package Id"
    },
    "resolved_package_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Resolved Package Name"
    },
    "installed_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Installed Version"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    }
  },
  "required": [
    "candidate_id",
    "name",
    "ecosystem"
  ],
  "title": "PackageRelevanceCandidate",
  "type": "object"
}