{
  "$defs": {
    "WikiHeuristicFinding": {
      "additionalProperties": false,
      "description": "One advisory inference that can never replace discovered machine evidence.",
      "properties": {
        "category": {
          "enum": [
            "SAFETY",
            "ARCHITECTURE",
            "HARDWARE",
            "OPERATIONS",
            "MAINTENANCE"
          ],
          "title": "Category",
          "type": "string"
        },
        "statement": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Statement",
          "type": "string"
        },
        "confidence": {
          "enum": [
            "LOW",
            "MEDIUM"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "basis": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Basis",
          "type": "array"
        },
        "verification": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Verification",
          "type": "string"
        },
        "source": {
          "default": "DETERMINISTIC_RULE",
          "enum": [
            "DETERMINISTIC_RULE",
            "ADAPT_AGENT_SKILL"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "category",
        "statement",
        "confidence",
        "basis",
        "verification"
      ],
      "title": "WikiHeuristicFinding",
      "type": "object"
    },
    "WikiUnknownAssessment": {
      "additionalProperties": false,
      "description": "Advisory review of one exact machine-reported unknown.",
      "properties": {
        "unknown": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Unknown",
          "type": "string"
        },
        "classification": {
          "enum": [
            "COLLECTED_EVIDENCE_REVIEW",
            "TARGET_PROBE_REQUIRED",
            "EXTERNAL_INPUT_REQUIRED",
            "INSUFFICIENT_EVIDENCE"
          ],
          "title": "Classification",
          "type": "string"
        },
        "assessment": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Assessment",
          "type": "string"
        },
        "confidence": {
          "enum": [
            "LOW",
            "MEDIUM"
          ],
          "title": "Confidence",
          "type": "string"
        },
        "basis": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Basis",
          "type": "array"
        },
        "next_step": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Next Step",
          "type": "string"
        },
        "source": {
          "default": "DETERMINISTIC_RULE",
          "enum": [
            "DETERMINISTIC_RULE",
            "ADAPT_AGENT_SKILL"
          ],
          "title": "Source",
          "type": "string"
        }
      },
      "required": [
        "unknown",
        "classification",
        "assessment",
        "confidence",
        "basis",
        "next_step"
      ],
      "title": "WikiUnknownAssessment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Skill-shaped output contract for optional, non-authoritative Wiki enrichment.",
  "properties": {
    "schema_version": {
      "const": "robot-wiki-insights/v1",
      "default": "robot-wiki-insights/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "robot_id": {
      "title": "Robot Id",
      "type": "string"
    },
    "discovery_id": {
      "title": "Discovery Id",
      "type": "string"
    },
    "findings": {
      "items": {
        "$ref": "#/$defs/WikiHeuristicFinding"
      },
      "maxItems": 40,
      "title": "Findings",
      "type": "array"
    },
    "unknown_assessments": {
      "items": {
        "$ref": "#/$defs/WikiUnknownAssessment"
      },
      "maxItems": 100,
      "title": "Unknown Assessments",
      "type": "array"
    }
  },
  "required": [
    "robot_id",
    "discovery_id"
  ],
  "title": "WikiInsightBundle",
  "type": "object"
}
