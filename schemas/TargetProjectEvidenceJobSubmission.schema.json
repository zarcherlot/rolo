        },
        "role": {
          "default": "SOURCE",
          "enum": [
            "SOURCE",
            "ARTIFACT",
            "RUNTIME"
          ],
          "title": "Role",
          "type": "string"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "kind"
      ],
      "title": "TargetProjectEvidenceCandidate",
      "type": "object"
    },
    "TargetProjectEvidenceKind": {
      "enum": [
        "BUILD_METADATA",
        "RUNTIME_METADATA",
        "SOURCE_ENTRYPOINT",
        "ROS_METADATA",
        "DOCUMENTATION"
      ],
      "title": "TargetProjectEvidenceKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Public bounded request for target-side project metadata observation.",
  "properties": {
    "schema_version": {
      "const": "rolo-target-project-evidence-job-submission/v1",
      "default": "rolo-target-project-evidence-job-submission/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "candidates": {
