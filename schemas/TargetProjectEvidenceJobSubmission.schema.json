      "maximum": 86400,
      "minimum": 60,
      "title": "Approval Ttl S",
      "type": "integer"
    },
    "timeout_s": {
      "default": 60.0,
      "maximum": 300.0,
      "minimum": 1.0,
      "title": "Timeout S",
      "type": "number"
    }
