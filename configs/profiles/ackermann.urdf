<?xml version="1.0"?>
<robot name="ackermann">
  <link name="base_link">
    <collision>
      <origin xyz="0.02 0 0.11" rpy="0 0 0"/>
      <geometry><box size="0.72 0.52 0.22"/></geometry>
    </collision>
  </link>
  <link name="front_left_steering_link"/>
  <link name="front_right_steering_link"/>
  <link name="rear_axle_link"/>
  <link name="front_camera_link"/>
  <link name="front_depth_link"/>
  <joint name="front_left_steering_joint" type="revolute">
    <parent link="base_link"/><child link="front_left_steering_link"/>
    <origin xyz="0.26 0.22 0.08" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-0.6" upper="0.6" effort="20" velocity="1.5"/>
  </joint>
  <joint name="front_right_steering_joint" type="revolute">
    <parent link="base_link"/><child link="front_right_steering_link"/>
    <origin xyz="0.26 -0.22 0.08" rpy="0 0 0"/><axis xyz="0 0 1"/>
    <limit lower="-0.6" upper="0.6" effort="20" velocity="1.5"/>
  </joint>
  <joint name="rear_axle_joint" type="continuous">
    <parent link="base_link"/><child link="rear_axle_link"/>
    <origin xyz="-0.26 0 0.08" rpy="0 0 0"/><axis xyz="0 1 0"/>
    <limit effort="30" velocity="12"/>
  </joint>
  <joint name="front_camera_joint" type="fixed">
    <parent link="base_link"/><child link="front_camera_link"/>
    <origin xyz="0.31 0 0.24" rpy="0 0 0"/>
  </joint>
  <joint name="front_depth_joint" type="fixed">
    <parent link="base_link"/><child link="front_depth_link"/>
    <origin xyz="0.29 0 0.20" rpy="0 0 0"/>
  </joint>
  <rolo
    description="Ackermann mobile base with RGB camera and depth range sensing"
    adapter="mock"
    drive_model="ackermann"
    base_link="base_link"
    hard_max_linear_velocity_mps="1.0"
    hard_max_angular_velocity_radps="1.2">
    <sensor name="front_camera" link="front_camera_link"
      semantic_uri="semantic://sensor/front_camera" modality="camera_rgb"/>
    <sensor name="range_primary" link="front_depth_link"
      semantic_uri="semantic://sensor/front_depth" modality="depth_camera"/>
    <feature name="mapping_2d" enabled="true"/>
    <feature name="navigation_2d" enabled="true"/>
    <feature name="docking" enabled="false"/>
  </rolo>
</robot>
