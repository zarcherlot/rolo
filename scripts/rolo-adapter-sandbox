#!/usr/bin/env python3
"""Linux bubblewrap launcher for generated Rolo adapters.

Contract: rolo-adapter-sandbox --cwd RELEASE_ROOT -- ADAPTER_ARGV...
"""

from __future__ import annotations

import os
import shutil
import sys
from pathlib import Path

PATH_ENVIRONMENT = (
    "PATH",
    "AMENT_PREFIX_PATH",
    "CMAKE_PREFIX_PATH",
    "COLCON_PREFIX_PATH",
    "LD_LIBRARY_PATH",
    "PYTHONPATH",
)
SYSTEM_DIRECTORIES = ("/usr", "/bin", "/lib", "/lib64")
SYSTEM_FILES = (
    "/etc/group",
    "/etc/hosts",
    "/etc/ld.so.cache",
    "/etc/nsswitch.conf",
    "/etc/passwd",
    "/etc/resolv.conf",
)
BASE_DIRECTORIES = {
    Path("/dev"),
    Path("/home"),
    Path("/home/rolo"),
    Path("/proc"),
    Path("/tmp"),
}


def fail(message: str) -> int:
    print(f"rolo-adapter-sandbox: {message}", file=sys.stderr)
    return 2


def parse(arguments: list[str]) -> tuple[Path, list[str]]:
    if len(arguments) < 4 or arguments[0] != "--cwd" or "--" not in arguments:
        raise ValueError("expected --cwd RELEASE_ROOT -- ADAPTER_ARGV...")
    separator = arguments.index("--")
    if separator != 2 or separator + 1 >= len(arguments):
        raise ValueError("expected exactly one --cwd before the adapter command")
    cwd = Path(arguments[1]).expanduser().resolve(strict=True)
    if not cwd.is_dir():
        raise ValueError("release root is not a directory")
    command = arguments[separator + 1 :]
    if any(not value or "\x00" in value for value in command):
        raise ValueError("adapter argv contains an invalid value")
    return cwd, command


def add_path(paths: set[Path], raw: str | None, *, file_ok: bool = False) -> None:
    if not raw:
        return
    candidate = Path(raw).expanduser()
    if not candidate.is_absolute() or not candidate.exists():
        return
    resolved = candidate.resolve()
    if resolved.is_dir() or (file_ok and resolved.is_file()):
        paths.add(resolved)


def add_system_path(paths: set[Path], raw: str, *, file_ok: bool = False) -> None:
    """Keep canonical loader paths such as /lib64 visible at their original names."""
    candidate = Path(raw)
    if candidate.is_dir() or (file_ok and candidate.is_file()):
        paths.add(candidate)


def add_virtual_environment(paths: set[Path], raw: str) -> None:
    candidate = Path(raw).expanduser()
    if not candidate.is_absolute() or not candidate.is_dir():
        return
    for parent in (candidate, *candidate.parents):
        if (parent / "pyvenv.cfg").is_file():
            add_path(paths, str(parent))
            for site_packages in parent.glob("lib/python*/site-packages"):
                if not site_packages.is_dir():
                    continue
                for pth in sorted(site_packages.glob("*.pth")):
                    try:
                        lines = pth.read_text(encoding="utf-8").splitlines()
                    except OSError:
                        continue
                    for line in lines:
                        value = line.strip()
                        if not value or value.startswith("#") or value.startswith("import "):
                            continue
                        referenced = Path(value).expanduser()
                        if not referenced.is_absolute():
                            referenced = site_packages / referenced
                        add_path(paths, str(referenced))
            return


def path_interpreter_alias_mounts() -> list[tuple[Path, Path]]:
    """Map version-manager Python roots to lexical venv shebang targets."""
    mounts: set[tuple[Path, Path]] = set()
    for raw in os.environ.get("PATH", "").split(os.pathsep):
        candidate = Path(raw).expanduser()
        if not candidate.is_absolute() or not candidate.is_dir():
            continue
        for name in ("python", "python3"):
            interpreter = candidate / name
            if not interpreter.is_symlink():
                continue
            target = Path(os.readlink(interpreter))
            if not target.is_absolute():
                target = interpreter.parent / target
            lexical_root = target.absolute().parent.parent
            try:
                source_root = lexical_root.resolve(strict=True)
            except OSError:
                continue
            if source_root.is_dir() and lexical_root != source_root:
                mounts.add((source_root, lexical_root))
    return sorted(mounts, key=lambda item: (len(item[1].parts), str(item[1])))


def readonly_paths(cwd: Path, command: list[str]) -> list[Path]:
    paths: set[Path] = {cwd}
    for raw in SYSTEM_DIRECTORIES:
        add_system_path(paths, raw)
    for raw in SYSTEM_FILES:
        add_system_path(paths, raw, file_ok=True)
    requested_executable = Path(command[0])
    if not requested_executable.is_absolute():
        located = shutil.which(command[0])
        if located is None:
            raise ValueError(f"adapter executable is unavailable: {command[0]}")
        requested_executable = Path(located)
    requested_executable = requested_executable.absolute()
    add_path(paths, str(requested_executable.parent))
    for parent in requested_executable.parents:
        if (parent / "pyvenv.cfg").is_file():
            add_path(paths, str(parent))
            break
    executable = requested_executable.resolve(strict=True)
    add_path(paths, str(executable.parent))
    for name in PATH_ENVIRONMENT:
        for raw in os.environ.get(name, "").split(os.pathsep):
            add_path(paths, raw)
            if name == "PATH":
                add_virtual_environment(paths, raw)
    add_path(paths, os.environ.get("FASTRTPS_DEFAULT_PROFILES_FILE"), file_ok=True)
    return sorted(paths, key=lambda value: (len(value.parts), str(value)))


def base_launch(bubblewrap: str) -> list[str]:
    return [
        bubblewrap,
        "--die-with-parent",
        "--new-session",
        "--unshare-all",
        "--proc",
        "/proc",
        "--dev",
        "/dev",
        "--tmpfs",
        "/tmp",
        "--dir",
        "/home",
        "--dir",
        "/home/rolo",
        "--setenv",
        "HOME",
        "/home/rolo",
        "--setenv",
        "TMPDIR",
        "/tmp",
        "--setenv",
        "TMP",
        "/tmp",
        "--setenv",
        "TEMP",
        "/tmp",
    ]


def add_mount_parent_directories(launch: list[str], paths: list[Path]) -> None:
    """Create empty destinations for deep, selectively mounted host paths."""
    parents: set[Path] = set()
    for path in paths:
        for parent in path.parents:
            if parent == Path("/") or parent in BASE_DIRECTORIES:
                continue
            parents.add(parent)
    for parent in sorted(parents, key=lambda value: (len(value.parts), str(value))):
        launch.extend(["--dir", str(parent)])


def main() -> int:
    if sys.platform != "linux":
        return fail("the bundled production launcher requires Linux")
    bubblewrap = shutil.which("bwrap")
    if bubblewrap is None:
        return fail("bubblewrap is required; install the target distribution's bubblewrap package")
    if sys.argv[1:] == ["--self-test"]:
        true_executable = shutil.which("true")
        if true_executable is None:
            return fail("sandbox self-test requires the system true executable")
        launch = base_launch(bubblewrap)
        self_test_paths: set[Path] = set()
        for raw in SYSTEM_DIRECTORIES:
            add_system_path(self_test_paths, raw)
        ordered_self_test_paths = sorted(
            self_test_paths, key=lambda value: (len(value.parts), str(value))
        )
        add_mount_parent_directories(launch, ordered_self_test_paths)
        for path in ordered_self_test_paths:
            launch.extend(["--ro-bind", str(path), str(path)])
        os.execv(
            bubblewrap,
            [*launch, "--chdir", "/", "--", str(Path(true_executable).resolve())],
        )
        return 127
    try:
        cwd, command = parse(sys.argv[1:])
        readonly = readonly_paths(cwd, command)
    except (OSError, ValueError) as exc:
        return fail(str(exc))
    launch = base_launch(bubblewrap)
    if os.environ.get("ROLO_ADAPTER_SANDBOX_NETWORK", "isolated") == "host":
        launch.append("--share-net")
    alias_mounts = path_interpreter_alias_mounts()
    add_mount_parent_directories(
        launch,
        [*readonly, *(destination for _, destination in alias_mounts)],
    )
    for path in readonly:
        launch.extend(["--ro-bind", str(path), str(path)])
    for source, destination in alias_mounts:
        launch.extend(["--ro-bind", str(source), str(destination)])
    launch.extend(["--chdir", str(cwd), "--", *command])
    os.execv(bubblewrap, launch)
    return 127


if __name__ == "__main__":
    raise SystemExit(main())
