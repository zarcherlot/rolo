# Copy to .env for local development. Never commit .env.
ROLO_CONFIG_DIR=.rolo/config
ROLO_ARTIFACT_DIR=.rolo/artifacts
# Must be outside the rolo source checkout. Only independently gated adapter
# releases are published here; Agent workspaces are temporary and deleted.
ROLO_OUTPUT_DIR=C:/ProgramData/rolo/output
ROLO_HOST=127.0.0.1
ROLO_PORT=8080

# Stage 1 Adapter Agent. Codex is the default. Leave BASE_URL empty for the
# provider's official/default endpoint, or set an OpenAI-compatible relay URL.
CODING_AGENT_PROVIDER=codex
CODING_AGENT_EXECUTOR=codex
CODING_AGENT_BASE_URL=
CODING_AGENT_API_KEY=
CODING_AGENT_MODEL=
CODING_AGENT_EXECUTABLE=codex
CODING_AGENT_TIMEOUT_S=1800
CODING_AGENT_AUTO_INSTALL=true
CODING_AGENT_REQUIRE_AUTH=true
CODING_AGENT_INSTALL_TIMEOUT_S=300
CODING_AGENT_INSTALL_HOME=
CODING_AGENT_HOME=

# mock: deterministic local development without network/API usage
# openai: use the OpenAI Responses API
ROBOT_USE_BACKEND=mock
OPENAI_API_KEY=
OPENAI_MODEL=

# After probes complete, use the configured OpenAI model for a bounded narrative
# summary. Missing credentials, model errors, or invalid output automatically fall
# back to the deterministic Wiki without blocking discovery.
WIKI_POLISH_ENABLED=true
WIKI_POLISH_MODEL=
WIKI_POLISH_TIMEOUT_S=60
