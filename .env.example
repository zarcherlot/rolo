# Copy to .env for local development. Never commit .env.
ROBOT_LOOP_ENV=development
ROBOT_LOOP_CONFIG_DIR=configs
ROBOT_LOOP_ARTIFACT_DIR=artifacts
ROBOT_LOOP_HOST=127.0.0.1
ROBOT_LOOP_PORT=8080

# mock: deterministic local development without network/API usage
# openai: use the OpenAI Responses API
ROBOT_USE_BACKEND=mock
OPENAI_API_KEY=
OPENAI_MODEL=
