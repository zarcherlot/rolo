# Copy to .env for local development. Never commit .env.
ROLO_CONFIG_DIR=.rolo/config
ROLO_ARTIFACT_DIR=.rolo/artifacts
# Must be outside the rolo source checkout. Only independently gated adapter
# releases are published here; Agent workspaces are temporary and deleted.
ROLO_OUTPUT_DIR=C:/ProgramData/rolo/output
# SENSITIVE operations are denied unless this protected host policy explicitly
# authorizes the current OS user or group. Every allow/deny is written to audit.
ROLO_INVOCATION_POLICY=.rolo/config/invocation-policy.yaml
ROLO_INVOCATION_AUDIT_LOG=.rolo/artifacts/runtime/invocation-audit.jsonl
# Optional admin-owned executable implementing rolo-r3-authorization-request/v1.
# Static invocation policy can never authorize R3 writes.
ROLO_R3_AUTHORIZER=
# Optional admin-owned execution-supervisor provider. Operations whose contract
# requires quiescence are denied unless it grants a bound lease that prevents
# target execution from starting for the complete invocation timeout.
ROLO_QUIESCENCE_PROVIDER=
# Optional deployment-owned read-only executable implementing
# robot-hardware-evidence-request/v1 -> robot-hardware-evidence/v1.
ROLO_HARDWARE_EVIDENCE_PROVIDER=
ROLO_HOST=127.0.0.1
ROLO_PORT=8080

# Stage 1 Adapter Agent. Codex is the default. Leave BASE_URL empty for the
# provider's official/default endpoint, or set an OpenAI-compatible relay URL.
CODING_AGENT_PROVIDER=codex
CODING_AGENT_EXECUTOR=codex
CODING_AGENT_BASE_URL=
CODING_AGENT_API_KEY=
CODING_AGENT_MODEL=
CODING_AGENT_EXECUTABLE=codex
CODING_AGENT_TIMEOUT_S=1800
CODING_AGENT_AUTO_INSTALL=true
CODING_AGENT_REQUIRE_AUTH=true
CODING_AGENT_INSTALL_TIMEOUT_S=300
CODING_AGENT_INSTALL_HOME=
CODING_AGENT_HOME=

# TargetOperationSlice activation remains shadow-only by default. Canary mode
# requires an exact robot ID or generated Adapt run ID selector. It changes only
# the compact Agent coding focus; current eligibility remains Bundle/release authority.
ADAPT_OPERATION_SLICE_MODE=shadow
ADAPT_OPERATION_SLICE_ROBOT_IDS=
ADAPT_OPERATION_SLICE_RUN_IDS=
ADAPT_OPERATION_SLICE_MAX_OPERATIONS=20

# mock: deterministic local development without network/API usage
# openai: use the OpenAI Responses API
ROBOT_USE_BACKEND=mock
OPENAI_API_KEY=
OPENAI_MODEL=

# After probes complete, use the configured OpenAI model for a bounded narrative
# summary. Missing credentials, model errors, or invalid output automatically fall
# back to the deterministic Wiki without blocking discovery.
WIKI_POLISH_ENABLED=true
WIKI_POLISH_MODEL=
WIKI_POLISH_TIMEOUT_S=60

# Optional bounded Adapt Agent skill for unverified Wiki insights. It receives a
# whitelisted evidence snapshot, runs Codex in a read-only sandbox, and falls back
# to deterministic rules on any failure. Set false to disable it.
WIKI_INSIGHTS_AGENT_ENABLED=true
WIKI_INSIGHTS_AGENT_TIMEOUT_S=120
WIKI_INSIGHTS_SKILL_PATH=skills/rolo-wiki-authoring/SKILL.md
